    const Icons = {
      Logo: () => (
        <svg className="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      ),
      Search: () => (
        <svg className="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      ),
      Plus: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      ),
      Back: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      ),
      Desktop: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
      ),
      Tablet: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
          <line x1="12" y1="18" x2="12.01" y2="18"></line>
        </svg>
      ),
      Mobile: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
          <line x1="12" y1="18" x2="12.01" y2="18"></line>
        </svg>
      ),
      Eye: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      ),
      Code: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      ),
      Folder: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
        </svg>
      ),
      File: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
        </svg>
      ),
      Chat: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
      ),
      Download: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      ),
      Copy: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      ),
      Settings: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      ),
      Sparkles: () => (
        <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.4-7.2L2 12l7.6-2.8z"></path>
        </svg>
      ),
      Close: () => (
        <svg className="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      )
    };


    // ═══════════════════════════════════════════════════════════════════
    // SKELETON LOADING PRIMITIVES
    // ═══════════════════════════════════════════════════════════════════

    function SkeletonBlock({ w, h, r, className }) {
      return (
        <div
          aria-hidden="true"
          className={("skeleton-base skeleton-shimmer ") + (className||"")}
          style={{ width: w||"100%", height: h||16, borderRadius: r||8 }}
        />
      );
    }

    function TemplateCardSkeleton() {
      return (
        <div aria-hidden="true" className="rounded-xl border border-white/5 bg-[#111825] overflow-hidden">
          <div className="skeleton-base skeleton-shimmer" style={{height:112}} />
          <div className="p-3 space-y-2">
            <SkeletonBlock h={12} w="70%" r={6} />
            <SkeletonBlock h={10} w="45%" r={6} />
          </div>
        </div>
      );
    }

    function ProjectCardSkeleton() {
      return (
        <div aria-hidden="true" className="rounded-xl border border-white/5 bg-[#111825] p-5 space-y-3">
          <div className="flex items-center justify-between">
            <SkeletonBlock h={18} w="55%" />
            <SkeletonBlock h={16} w="60px" />
          </div>
          <SkeletonBlock h={100} r={10} />
          <SkeletonBlock h={12} w="80%" />
          <SkeletonBlock h={12} w="60%" />
        </div>
      );
    }

    function CodeEditorSkeleton() {
      const rows = [
        ["15%","45%","25%"],["20%","55%"],["10%","30%","40%","10%"],
        ["20%","50%"],["15%","35%","30%"],["10%","60%"],["20%","40%","15%"],
        ["15%","55%"],["10%","25%","45%"],["20%","30%","20%"]
      ];
      return (
        <div aria-hidden="true" aria-label="Code loading" className="p-4 space-y-2.5">
          {rows.map((segs,i) => (
            <div key={i} className="flex items-center gap-2" style={{paddingLeft:(i%3)*16}}>
              <SkeletonBlock h={10} w="28px" r={4} />
              {segs.map((w,j) => <SkeletonBlock key={j} h={10} w={w} r={4} />)}
            </div>
          ))}
        </div>
      );
    }

    function PreviewSkeleton() {
      return (
        <div aria-hidden="true" className="flex-1 flex flex-col" style={{background:"#0c0f1a"}}>
          <div className="h-9 border-b border-white/5 flex items-center gap-2 px-3">
            <div className="flex gap-1.5">
              {["#7f1d1d","#78350f","#14532d"].map(c=>(
                <div key={c} style={{width:10,height:10,borderRadius:"50%",background:c,opacity:0.6}}/>
              ))}
            </div>
            <SkeletonBlock h={20} w="60%" r={20} />
          </div>
          <div className="p-6 space-y-4">
            <SkeletonBlock h={80} r={12} />
            <div className="grid grid-cols-3 gap-4">
              {[1,2,3].map(n => <SkeletonBlock key={n} h={60} r={10} />)}
            </div>
            <SkeletonBlock h={48} r={10} />
            <div className="grid grid-cols-2 gap-4">
              {[1,2].map(n => <SkeletonBlock key={n} h={44} r={10} />)}
            </div>
          </div>
        </div>
      );
    }

    function GenerationOverlay({ prompt, stage }) {
      const STAGES = [
        "Analysing your website brief\u2026",
        "Planning page structure\u2026",
        "Generating project files\u2026",
        "Validating outputs\u2026",
        "Preparing live preview\u2026"
      ];
      const cur = Math.min(stage||0, STAGES.length-1);
      return (
        <div
          role="status"
          aria-live="polite"
          aria-label={STAGES[cur]}
          className="fixed inset-0 z-50 flex flex-col items-center justify-center bg-[#070913]/95 backdrop-blur-sm"
        >
          <div className="flex flex-col items-center gap-6 max-w-sm w-full px-6">
            <div className="w-14 h-14 rounded-2xl bg-gradient-to-tr from-violet-600 to-blue-500 flex items-center justify-center shadow-xl shadow-violet-500/30">
              <svg className="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                <polyline points="2 17 12 22 22 17"/>
                <polyline points="2 12 12 17 22 12"/>
              </svg>
            </div>
            <div className="flex gap-2">
              <div className="w-3 h-3 rounded-full bg-violet-500 vf-dot-1"/>
              <div className="w-3 h-3 rounded-full bg-violet-500 vf-dot-2"/>
              <div className="w-3 h-3 rounded-full bg-violet-500 vf-dot-3"/>
            </div>
            <div className="text-center space-y-1">
              <p className="text-sm font-semibold text-white">{STAGES[cur]}</p>
              <p className="text-xs text-slate-400 line-clamp-2">{prompt}</p>
            </div>
            <div className="w-full h-1.5 vf-progress-bar">
              <div className="vf-progress-fill" style={{height:"100%",width:"30%"}}/>
            </div>
            <div className="flex gap-1.5 flex-wrap justify-center">
              {STAGES.map((s,i)=>(
                <span key={i} className={"px-2 py-0.5 rounded text-[10px] font-medium "+(
                  i<cur?"bg-emerald-500/20 text-emerald-300":
                  i===cur?"bg-violet-500/30 text-violet-200":
                  "bg-white/5 text-slate-500"
                )}>
                  {i<cur?"✓ ":""}{s.replace("\u2026","")}
                </span>
              ))}
            </div>
          </div>
        </div>
      );
    }

    // ═══════════════════════════════════════════════════════════════════
    // REFERENCE DASHBOARD STATIC DATA
    // ═══════════════════════════════════════════════════════════════════
    const TEMPLATE_GALLERY_DATA = [
      {
        id:"tmpl-portfolio", title:"Modern Portfolio", category:"Portfolio",
        headline:"Creative Digital Designer",
        prompt:"Create a high-end creative digital designer portfolio with case studies, dark theme, interactive prototypes, and advisory bookings.",
        tmplType:"portfolio", accent:"from-violet-600 to-indigo-600"
      },
      {
        id:"tmpl-business", title:"Business Pro", category:"Business",
        headline:"Grow Your Business\nWith Modern Solutions",
        prompt:"Build an enterprise corporate platform for startups with growth metrics, advisory practice areas, and consultation scheduling.",
        tmplType:"business", accent:"from-blue-600 to-cyan-500"
      },
      {
        id:"tmpl-ecommerce", title:"E-commerce Store", category:"E-commerce",
        headline:"Best Products for\na Better You",
        prompt:"Design a minimalist e-commerce storefront with audio and lifestyle products, cart preview, and customer reviews.",
        tmplType:"ecommerce", accent:"from-pink-600 to-rose-500"
      },
      {
        id:"tmpl-food", title:"Food & Restaurant", category:"Restaurant",
        headline:"Delicious Food for\nEvery Mood",
        prompt:"Create an artisan restaurant website with tasting menus, farm-to-table sourcing, and online table reservations.",
        tmplType:"restaurant", accent:"from-amber-600 to-orange-500"
      },
      {
        id:"tmpl-travel", title:"Travel Explorer", category:"Travel",
        headline:"Explore The World",
        prompt:"Build an inspiring travel expedition agency website with scenic itineraries, adventure booking, and customer traveler stories.",
        tmplType:"travel", accent:"from-cyan-600 to-emerald-500"
      }
    ];

    const MORE_CATS = [
      {label:"Portfolio Templates",    sub:"Showcase your work beautifully", icon:"\uD83D\uDC64", c:"from-violet-600 to-indigo-600"},
      {label:"Business Templates",     sub:"For startups & growing brands",   icon:"\uD83D\uDCBC", c:"from-blue-600 to-cyan-500"},
      {label:"E-commerce Templates",   sub:"Sell your products online",       icon:"\uD83D\uDED2", c:"from-pink-600 to-rose-500"},
      {label:"Blog Templates",         sub:"Share your thoughts",             icon:"\uD83D\uDCDD", c:"from-amber-600 to-orange-500"},
      {label:"Landing Page Templates", sub:"High-converting designs",         icon:"\uD83D\uDE80", c:"from-cyan-600 to-emerald-500"}
    ];

    const FEATURE_CARDS_DATA = [
      {icon:"\uD83D\uDDB1\uFE0F", title:"Drag & Drop Builder",   sub:"Build without limits"},
      {icon:"\u2728",          title:"AI Content Generator", sub:"Write, design, create"},
      {icon:"\uD83C\uDF10",    title:"Custom Domain",         sub:"Make it yours"},
      {icon:"\u2601\uFE0F",    title:"Free Hosting",          sub:"Fast & secure"},
      {icon:"\uD83D\uDCC8",    title:"SEO Optimization",      sub:"Rank on Google"},
      {icon:"\uD83D\uDCF1",    title:"Mobile Responsive",     sub:"Looks great everywhere"}
    ];

    const TOP_FEAT = [
      {icon:"\u2728", label:"AI Website Builder", sub:"Build with AI"},
      {icon:"\uD83D\uDCCB", label:"Templates",   sub:"100+ Templates"},
      {icon:"\uD83C\uDF10", label:"Domain & Hosting", sub:"Get online fast"},
      {icon:"\uD83D\uDCBB", label:"Custom Code",  sub:"Edit your code"},
      {icon:"\uD83D\uDD0D", label:"SEO Tools",    sub:"Rank higher"},
      {icon:"\uD83D\uDCCA", label:"Analytics",    sub:"Track performance"}
    ];

    // ─── Vector-art template thumbnails ──────────────────────────
    function TemplateThumbnail({ tmplType, headline }) {
      const cfg = {
        portfolio: {bg:"#0d0f1e", acc:"#8b5cf6", bw:"65%", bc:"#6d28d9"},
        business:  {bg:"#0e1828", acc:"#3b82f6", bw:"75%", bc:"#2563eb"},
        ecommerce: {bg:"#1a0e18", acc:"#ec4899", bw:"55%", bc:"#be185d"},
        restaurant:{bg:"#1a1008", acc:"#f59e0b", bw:"80%", bc:"#b45309"},
        travel:    {bg:"#081818", acc:"#06b6d4", bw:"70%", bc:"#0284c7"}
      }[tmplType] || {bg:"#0d0f1e", acc:"#8b5cf6", bw:"65%", bc:"#6d28d9"};
      return (
        <div style={{background:cfg.bg,height:112,padding:10,position:"relative",overflow:"hidden"}}>
          <div style={{position:"absolute",inset:0,opacity:0.25,background:`radial-gradient(ellipse at 80% 20%,${cfg.acc}90,transparent 70%)`}}/>
          <div style={{display:"flex",gap:4,marginBottom:6}}>
            {["#ef4444","#f59e0b","#22c55e"].map(c=>(
              <div key={c} style={{width:6,height:6,borderRadius:"50%",background:c}}/>
            ))}
          </div>
          <div style={{position:"relative",zIndex:1}}>
            {(headline||"").split("\n").map((line,i)=>(
              <div key={i} style={{
                fontSize: i===0?11:10, fontWeight:700,
                color: i===0?"#fff":cfg.acc,
                lineHeight:1.25, marginBottom:1,
                whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis"
              }}>{line}</div>
            ))}
          </div>
          <div style={{position:"absolute",bottom:10,left:10,right:10}}>
            <div style={{height:3,background:"rgba(255,255,255,0.08)",borderRadius:4}}>
              <div style={{height:"100%",width:cfg.bw,background:cfg.bc,borderRadius:4}}/>
            </div>
          </div>
        </div>
      );
    }

    // ─── 3-D Hero Browser Mock ─────────────────────────────────
    function HeroMock3D() {
      const ref = useRef(null);
      return (
        <div className="relative max-w-[270px] flex-shrink-0" style={{perspective:900}}>
          <div className="absolute -top-7 right-0 text-[10px] text-slate-400 italic whitespace-nowrap" aria-hidden="true">From idea to live in minutes</div>
          <div
            ref={ref}
            className="rounded-xl border border-blue-500/30 bg-gradient-to-tr from-[#121933] to-[#1c2448] p-2.5 shadow-2xl shadow-blue-500/20"
            style={{transform:"rotateX(4deg) rotateY(-4deg)", transition:"transform 0.5s ease"}}
            onMouseEnter={e=>e.currentTarget.style.transform="rotateX(0) rotateY(0)"}
            onMouseLeave={e=>e.currentTarget.style.transform="rotateX(4deg) rotateY(-4deg)"}
          >
            <div className="flex items-center justify-between pb-2 border-b border-white/10 mb-2">
              <div className="flex gap-1.5">
                {["#ef4444","#f59e0b","#22c55e"].map(c=>(
                  <span key={c} style={{display:"block",width:6,height:6,borderRadius:"50%",background:c}}/>
                ))}
              </div>
              <span className="text-[9px] text-cyan-400 font-mono">Your Website</span>
              <span className="px-1.5 py-0.5 rounded bg-blue-500/30 text-[8px] text-blue-200 font-bold">AI ✨</span>
            </div>
            <div className="h-14 rounded-lg bg-gradient-to-r from-blue-600/30 via-indigo-600/30 to-purple-600/20 border border-white/10 p-2 flex flex-col justify-between mb-2">
              <div className="h-1.5 w-2/3 bg-white/40 rounded"/>
              <div className="h-1 w-1/2 bg-white/20 rounded"/>
              <div className="h-3 w-12 bg-blue-500 rounded flex items-center justify-center" style={{fontSize:7,fontWeight:"bold",color:"#fff"}}>Launch</div>
            </div>
            <div className="grid grid-cols-2 gap-1.5">
              {[["bg-cyan-400/60","bg-cyan-400/30"],["bg-violet-400/60","bg-violet-400/30"]].map(([a,b],i)=>(
                <div key={i} className="h-8 rounded bg-black/40 border border-white/5 p-1.5">
                  <div className={"h-1.5 w-10 "+a+" rounded mb-1"}/>
                  <div className={"h-1 w-full "+b+" rounded"}/>
                </div>
              ))}
            </div>
            <div className="flex items-center justify-between pt-2 border-t border-white/5 mt-2" style={{fontSize:8,color:"rgba(148,163,184,0.8)"}}>
              <span style={{color:"#34d399",fontFamily:"monospace"}}>● Online</span>
              <span>100% Responsive</span>
            </div>
          </div>
        </div>
      );
    }

    // ─── AI Robot Avatar ───────────────────────────────────────
    function AIRobot() {
      return (
        <div className="w-16 h-16 rounded-2xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-violet-500 p-px shadow-xl shadow-blue-500/30 flex-shrink-0" aria-hidden="true">
          <div className="w-full h-full bg-[#0d1326] rounded-[14px] flex flex-col items-center justify-center relative overflow-hidden">
            <div className="w-px h-3 bg-blue-400 rounded-full mb-0.5"/>
            <div className="w-9 h-6 rounded-full bg-cyan-400/20 border border-cyan-400/60 flex items-center justify-center gap-2 shadow-inner">
              <span className="w-1.5 h-1.5 rounded-full bg-cyan-300 animate-pulse"/>
              <span className="w-1.5 h-1.5 rounded-full bg-cyan-300 animate-pulse"/>
            </div>
            <div className="w-4 h-1 bg-cyan-400/40 rounded-full mt-1"/>
          </div>
        </div>
      );
    }

    // ─── Dashboard Sidebar ─────────────────────────────────────
    function DashboardSidebar({ activeNav, setActiveNav, onCreateNew }) {
      const NAV = [
        {id:"home",     label:"Home",             icon:<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>},
        {id:"builder",  label:"AI Website Builder",icon:<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.4-7.2L2 12z"/></svg>},
        {id:"templates",label:"Templates",          icon:<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>},
        {id:"projects", label:"My Projects",         icon:<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>},
        {id:"domain",   label:"Domain & Hosting",   icon:<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>},
        {id:"aitools",  label:"AI Tools",            icon:<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M15 4V2"/><path d="M15 16v-2"/><path d="M8 9h2"/><path d="M20 9h2"/><path d="M17.8 11.8 19 13"/><path d="M15 9h0"/><path d="M17.8 6.2 19 5"/><path d="m3 21 9-9"/><path d="M12.2 6.2 11 5"/></svg>},
        {id:"settings", label:"Settings",            icon:<svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>}
      ];
      const QUICK = [
        {label:"+ Create New Website", fn:onCreateNew},
        {label:"New Project",          fn:onCreateNew},
        {label:"Explore Templates",    fn:()=>setActiveNav("templates")},
        {label:"Upgrade to Pro",       fn:()=>{}}
      ];
      return (
        <nav className="vf-sidebar" aria-label="Primary navigation">
          <div className="px-4 py-5 border-b border-white/5 flex items-center gap-2.5">
            <div className="w-8 h-8 rounded-xl bg-gradient-to-tr from-violet-600 to-blue-500 flex items-center justify-center shadow-lg flex-shrink-0">
              <svg className="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            </div>
            <div>
              <div className="font-extrabold text-sm tracking-tight brand-gradient-text">VibeForge</div>
              <div className="text-[10px] text-slate-500">Ideas → Websites</div>
            </div>
          </div>

          <div className="px-2 py-3 space-y-0.5">
            {NAV.map(item=>(
              <button
                key={item.id}
                onClick={()=>{setActiveNav(item.id); if(item.id==="builder")onCreateNew();}}
                className={"w-full flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-medium vf-nav-item "+(activeNav===item.id?"vf-nav-active":"text-slate-400")}
              >
                {item.icon}
                {item.label}
              </button>
            ))}
          </div>

          <div className="px-3 py-3 border-t border-white/5">
            <p className="text-[10px] uppercase font-semibold text-slate-500 tracking-wider mb-2">Quick Actions</p>
            {QUICK.map(q=>(
              <button key={q.label} onClick={q.fn} className="w-full text-left px-2.5 py-1.5 rounded-lg text-[11px] text-slate-400 hover:text-white hover:bg-white/5 transition-colors flex items-center gap-2">
                <span className="text-violet-400" aria-hidden="true">▸</span>
                {q.label}
              </button>
            ))}
          </div>

          <div className="flex-1"/>

          <div className="mx-3 mb-4 p-3 rounded-xl bg-gradient-to-br from-violet-600/25 to-blue-600/20 border border-violet-500/25">
            <div className="flex items-center gap-2 mb-2">
              <span className="text-amber-400">👑</span>
              <span className="text-xs font-bold text-white">VibeForge Pro</span>
            </div>
            <p className="text-[10px] text-slate-400 mb-2 leading-relaxed">Unlock premium features, advanced AI, and more.</p>
            <button className="w-full py-1.5 rounded-lg btn-gradient text-white text-[11px] font-bold">Upgrade Now →</button>
          </div>

          <div className="px-4 py-3 border-t border-white/5 flex items-center gap-2">
            <svg className="w-3 h-3 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M2 10v4"/><path d="M6 6v12"/><path d="M10 3v18"/><path d="M14 8v8"/><path d="M18 5v14"/><path d="M22 10v4"/></svg>
            <span className="text-[10px] text-slate-500 italic">Build. Create. Inspire.</span>
          </div>
        </nav>
      );
    }

    // ─── Top Bar ───────────────────────────────────────────────
    function DashboardTopBar({ search, setSearch, isDark, setIsDark, onSettings }) {
      const inputRef = useRef(null);
      useEffect(()=>{
        const h = e=>{ if((e.ctrlKey||e.metaKey)&&e.key==="k"){e.preventDefault();inputRef.current&&inputRef.current.focus();} };
        document.addEventListener("keydown",h);
        return ()=>document.removeEventListener("keydown",h);
      },[]);
      return (
        <div className="vf-topbar">
          <div className="relative" style={{flex:"1 1 0%",maxWidth:400}}>
            <svg className="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-500 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input
              ref={inputRef}
              type="search"
              value={search}
              onChange={e=>setSearch(e.target.value)}
              placeholder="Search templates, projects, or features..."
              aria-label="Search templates and projects"
              className="w-full pl-8 pr-20 py-1.5 text-xs rounded-full bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-violet-500/60 transition-colors"
            />
            <span className="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-slate-500 bg-white/5 px-1.5 py-0.5 rounded border border-white/10 pointer-events-none">Ctrl+K</span>
          </div>
          <div style={{flex:1}}/>
          <button onClick={()=>setIsDark(!isDark)} aria-label={isDark?"Light mode":"Dark mode"} className="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-slate-300 hover:text-white hover:bg-white/10 transition-colors">
            {isDark
              ? <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
              : <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/></svg>
            }
          </button>
          <button aria-label="Notifications" className="relative w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-slate-300 hover:text-white hover:bg-white/10 transition-colors">
            <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
            <span className="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-rose-500 border border-[#0b0f1a]" aria-hidden="true"/>
          </button>
          <button onClick={onSettings} aria-label="Open settings" className="flex items-center gap-2 px-2 py-1 rounded-lg hover:bg-white/5 transition-colors">
            <div className="w-7 h-7 rounded-full bg-gradient-to-tr from-violet-600 to-blue-500 flex items-center justify-center text-white text-[11px] font-bold flex-shrink-0">J</div>
            <span className="text-xs text-slate-300 hidden sm:block">Jani</span>
            <svg className="w-3 h-3 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
        </div>
      );
    }

    // ─── Right Panel ───────────────────────────────────────────
    function DashboardRightPanel({ projects, onOpenProject, onChatOpen }) {
      const recent = projects.slice(0,5);
      return (
        <aside className="vf-right-panel" aria-label="AI Assistant and Recent Projects">
          <div className="m-3 p-3.5 rounded-xl bg-gradient-to-br from-[#0e1a38] to-[#101c40] border border-blue-500/25">
            <div className="flex items-start justify-between mb-3">
              <div>
                <div className="flex items-center gap-1.5 mb-1">
                  <svg className="w-3.5 h-3.5 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.4-7.2L2 12z"/></svg>
                  <span className="text-xs font-bold text-white">AI Assistant</span>
                </div>
                <span className="text-[10px] text-blue-400 bg-blue-400/10 px-1.5 py-0.5 rounded font-medium">Beta</span>
              </div>
              <AIRobot/>
            </div>
            <p className="text-[11px] text-slate-400 leading-relaxed mb-3">Need help? I can design, write, and build your website. Just tell me what you're thinking!</p>
            <button onClick={onChatOpen} className="w-full py-2 rounded-lg btn-gradient text-white text-[11px] font-bold flex items-center justify-center gap-2 shadow">
              <svg className="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Chat with AI →
            </button>
          </div>

          {recent.length>0&&(
            <div className="px-3 pb-3">
              <div className="flex items-center justify-between mb-2">
                <span className="text-xs font-semibold text-white">Recent Projects</span>
                <button className="text-[10px] text-violet-400 hover:text-violet-300 transition-colors">View all →</button>
              </div>
              <div className="space-y-1.5">
                {recent.map(p=>(
                  <button key={p.id} onClick={()=>onOpenProject(p)} className="w-full flex items-center gap-2.5 p-2 rounded-lg hover:bg-white/5 transition-colors group text-left">
                    <div className={"w-10 h-8 rounded-lg bg-gradient-to-br "+(p.accentColor||"from-violet-600 to-blue-500")+" flex-shrink-0 flex items-center justify-center"}>
                      <svg className="w-3.5 h-3.5 text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                    </div>
                    <div className="flex-1 min-w-0">
                      <p className="text-[11px] font-semibold text-slate-200 truncate group-hover:text-white">{p.name}</p>
                      <p className="text-[10px] text-slate-500">{p.updatedAt}</p>
                    </div>
                    <svg className="w-3.5 h-3.5 text-slate-600 group-hover:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                  </button>
                ))}
              </div>
            </div>
          )}

          <div className="px-3 pb-4 border-t border-white/5 pt-3">
            <p className="text-xs font-semibold text-white mb-2">Top Features</p>
            <div className="grid grid-cols-3 gap-1.5">
              {TOP_FEAT.map(f=>(
                <button key={f.label} className="flex flex-col items-center gap-1 p-2 rounded-lg bg-white/3 hover:bg-white/6 border border-white/5 transition-colors">
                  <span style={{fontSize:14}}>{f.icon}</span>
                  <span className="text-[9px] text-slate-300 text-center leading-tight font-medium">{f.label}</span>
                  <span className="text-[8px] text-slate-500 text-center">{f.sub}</span>
                </button>
              ))}
            </div>
          </div>
        </aside>
      );
    }

    // ─── Dashboard Hero ────────────────────────────────────────
    function DashboardHero({ onGenerate, isGenerating }) {
      const [heroPrompt, setHeroPrompt] = React.useState("");
      const CHIPS = ["Portfolio","Business","E-commerce","Blog","Landing Page","Online Store"];
      return (
        <section className="vf-hero-bg relative px-6 pt-6 pb-6 border-b border-white/5" aria-label="Website generator" aria-busy={isGenerating}>
          <div className="flex items-center gap-8">
            <div className="flex-1 min-w-0">
              <div className="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-[11px] font-semibold bg-violet-500/15 text-violet-300 border border-violet-500/25 mb-3">
                <svg className="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.4-7.2L2 12z"/></svg>
                AI-Powered Website Builder
              </div>
              <h1 className="text-3xl font-extrabold text-white tracking-tight mb-1 leading-tight">Turn Your Ideas Into</h1>
              <div className="text-3xl font-extrabold tracking-tight mb-3 leading-tight brand-gradient-text">Stunning Websites</div>
              <p className="text-sm text-slate-400 mb-4 leading-relaxed max-w-lg">Create professional websites, landing pages, and online stores with the power of AI. No coding required.</p>
              <div className="flex items-center gap-2 p-1.5 rounded-xl bg-white/5 border border-white/10 focus-within:border-violet-500/50 transition-colors mb-3">
                <svg className="w-4 h-4 text-slate-500 ml-2 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.4-7.2L2 12z"/></svg>
                <input
                  type="text"
                  value={heroPrompt}
                  onChange={e=>setHeroPrompt(e.target.value)}
                  onKeyDown={e=>{if(e.key==="Enter"&&heroPrompt.trim().length>=10)onGenerate(heroPrompt);}}
                  placeholder="Describe your website (e.g. portfolio, business, blog, e-commerce...)"
                  disabled={isGenerating}
                  aria-label="Describe your website"
                  className="flex-1 bg-transparent text-sm text-white placeholder-slate-500 focus:outline-none min-w-0 py-1"
                />
                <button
                  onClick={()=>onGenerate(heroPrompt)}
                  disabled={heroPrompt.trim().length<10||isGenerating}
                  className="px-4 py-2 rounded-lg btn-gradient text-white text-xs font-bold flex items-center gap-1.5 flex-shrink-0 disabled:opacity-50 disabled:cursor-not-allowed shadow-lg"
                >
                  {isGenerating
                    ? <><span className="w-3 h-3 rounded-full border-2 border-white/30 border-t-white animate-spin"/>Generating&hellip;</>
                    : <>Generate Website &rarr;</>
                  }
                </button>
              </div>
              <div className="flex items-center gap-2 flex-wrap">
                <span className="text-[11px] text-slate-500 flex-shrink-0">Try these popular ideas:</span>
                {CHIPS.map(chip=>(
                  <button key={chip} onClick={()=>setHeroPrompt("Build a professional "+chip.toLowerCase()+" website with modern design, animations, and full content.")} className="px-2.5 py-1 rounded-full border border-white/10 text-[11px] text-slate-400 hover:text-white hover:border-violet-500/50 hover:bg-violet-500/10 transition-all">
                    {chip}
                  </button>
                ))}
              </div>
            </div>
            <div className="hidden lg:block flex-shrink-0">
              <HeroMock3D/>
            </div>
          </div>
        </section>
      );
    }

    // ─── Template Gallery ──────────────────────────────────────
    function TemplateGallery({ search, onUseTemplate }) {
      const CATS = ["All","Portfolio","Business","E-commerce","Blog","Landing Page","Education","Agency","Restaurant","Travel"];
      const [cat, setCat] = React.useState("All");
      const filtered = useMemo(()=>{
        return TEMPLATE_GALLERY_DATA.filter(t=>{
          const mc = cat==="All"||t.category===cat;
          const ms = !search||t.title.toLowerCase().includes(search.toLowerCase())||t.category.toLowerCase().includes(search.toLowerCase());
          return mc&&ms;
        });
      },[cat,search]);
      return (
        <section className="px-6 pt-5 pb-6">
          <div className="flex items-start justify-between mb-3">
            <div className="flex items-center gap-2.5">
              <div className="w-8 h-8 rounded-lg bg-blue-500/20 flex items-center justify-center flex-shrink-0">
                <svg className="w-4 h-4 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
              </div>
              <div>
                <h2 className="text-sm font-bold text-white">Website Templates</h2>
                <p className="text-[11px] text-slate-500">Choose from 100+ professionally designed templates for every industry.</p>
              </div>
            </div>
            <button className="text-xs text-violet-400 hover:text-violet-300 transition-colors whitespace-nowrap">View all templates &rarr;</button>
          </div>
          <div className="flex items-center gap-1.5 mb-4 overflow-x-auto pb-1">
            {CATS.map(c=>(
              <button key={c} onClick={()=>setCat(c)} className={"px-3 py-1 rounded-full text-[11px] font-medium whitespace-nowrap transition-all flex-shrink-0 "+(cat===c?"bg-violet-600 text-white shadow shadow-violet-600/30":"bg-white/5 text-slate-400 hover:text-white border border-white/10")}>
                {c}
              </button>
            ))}
          </div>
          <div className="grid vf-fadein" style={{gridTemplateColumns:"repeat(auto-fill, minmax(155px, 1fr))",gap:12}} aria-label="Website templates" aria-busy={false}>
            {filtered.length>0
              ? filtered.map(tmpl=>(
                <div key={tmpl.id} className="rounded-xl border border-white/8 bg-[#111825] overflow-hidden vf-card-hover cursor-pointer group relative" onClick={()=>onUseTemplate(tmpl)}>
                  <div className="relative">
                    <TemplateThumbnail tmplType={tmpl.tmplType} headline={tmpl.headline}/>
                    <div className="tmpl-overlay">
                      <button onClick={e=>{e.stopPropagation();onUseTemplate(tmpl);}} className="w-full py-1.5 rounded-lg btn-gradient text-white text-[10px] font-bold text-center shadow">Use Template</button>
                    </div>
                  </div>
                  <div className="p-2.5 border-t border-white/5 flex items-center justify-between">
                    <div>
                      <p className="text-[11px] font-semibold text-slate-200 truncate">{tmpl.title}</p>
                      <p className="text-[10px] text-slate-500">{tmpl.category}</p>
                    </div>
                    <button onClick={e=>{e.stopPropagation();onUseTemplate(tmpl);}} className="w-5 h-5 rounded flex items-center justify-center bg-white/5 hover:bg-violet-600/40 text-slate-400 hover:text-white transition-colors flex-shrink-0" aria-label={"Use "+tmpl.title}>
                      <svg className="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </button>
                  </div>
                </div>
              ))
              : Array.from({length:5}).map((_,i)=><TemplateCardSkeleton key={i}/>)
            }
          </div>
        </section>
      );
    }

    // ─── More Templates + Features ─────────────────────────────
    function DashboardExtras({ onUseTemplate }) {
      return (
        <>
          <section className="px-6 pb-5">
            <h2 className="text-sm font-bold text-white mb-3">More Templates</h2>
            <div className="grid" style={{gridTemplateColumns:"repeat(auto-fill, minmax(150px,1fr))",gap:10}}>
              {MORE_CATS.map(c=>(
                <button key={c.label} className="flex flex-col gap-2 p-3 rounded-xl border border-white/8 bg-[#111825] hover:border-violet-500/30 vf-card-hover text-left">
                  <div className={"w-7 h-7 rounded-lg bg-gradient-to-tr "+c.c+" flex items-center justify-center text-sm"}>{c.icon}</div>
                  <div>
                    <p className="text-[11px] font-semibold text-slate-200">{c.label}</p>
                    <p className="text-[10px] text-slate-500 mt-0.5">{c.sub}</p>
                  </div>
                </button>
              ))}
            </div>
          </section>
          <section className="px-6 pb-6">
            <h2 className="text-sm font-bold text-white mb-3">Powerful Features</h2>
            <div className="grid" style={{gridTemplateColumns:"repeat(auto-fill, minmax(140px,1fr))",gap:10}}>
              {FEATURE_CARDS_DATA.map(f=>(
                <div key={f.title} className="flex items-center gap-2.5 p-3 rounded-xl border border-white/8 bg-[#111825] hover:border-blue-500/30 vf-card-hover">
                  <div className="w-7 h-7 rounded-lg bg-blue-500/15 flex items-center justify-center text-sm flex-shrink-0">{f.icon}</div>
                  <div>
                    <p className="text-[11px] font-semibold text-slate-200">{f.title}</p>
                    <p className="text-[10px] text-slate-500">{f.sub}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>
        </>
      );
    }

    // ─── Full Reference Dashboard ──────────────────────────────
    function ReferenceDashboard({ projects, onGenerate, onUseTemplate, onOpenProject, onCreateNew, onSettings, isGenerating }) {
      const [search, setSearch] = React.useState("");
      const [isDark, setIsDark] = React.useState(true);
      const [activeNav, setActiveNav] = React.useState("home");
      return (
        <div className="vf-app-shell">
          <DashboardTopBar search={search} setSearch={setSearch} isDark={isDark} setIsDark={setIsDark} onSettings={onSettings}/>
          <div className="vf-dashboard-layout">
            <DashboardSidebar activeNav={activeNav} setActiveNav={setActiveNav} onCreateNew={onCreateNew}/>
            <div className="vf-main-area">
              <DashboardHero onGenerate={onGenerate} isGenerating={isGenerating}/>
              <TemplateGallery search={search} onUseTemplate={onUseTemplate}/>
              <DashboardExtras onUseTemplate={onUseTemplate}/>
              <footer className="border-t border-white/5 py-3 px-6 text-center text-[10px] text-slate-600">
                VibeForge &bull; Build Your Dream Website &bull; Faster. Smarter. Easier.
              </footer>
            </div>
            <DashboardRightPanel projects={projects} onOpenProject={onOpenProject} onChatOpen={()=>setSearch("")}/>
          </div>
        </div>
      );
    }

    // --- Main App Component ---
    function App() {
      const STORAGE_KEY = 'vibeforge_projects_v2';
      const API_KEY_STORAGE = 'vibeforge_gemini_api_key';

      // Load initial projects from localStorage or default seed
      const [projects, setProjects] = useState(() => {
        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved) {
            const parsed = JSON.parse(saved);
            if (Array.isArray(parsed) && parsed.length > 0) return parsed;
          }
        } catch (e) {
          console.warn("Could not read from localStorage:", e);
        }
        return DEFAULT_PROJECTS;
      });

      const [activeView, setActiveView] = useState('dashboard'); // 'dashboard' | 'builder'
      const [activeProject, setActiveProject] = useState(projects[0] || DEFAULT_PROJECTS[0]);
      const [searchQuery, setSearchQuery] = useState('');
      const [selectedCategory, setSelectedCategory] = useState('All');
      
      // Builder Workspace State
      const [activeTab, setActiveTab] = useState('preview'); // 'preview' | 'code' | 'split'
      const [viewport, setViewport] = useState('desktop'); // 'desktop' | 'tablet' | 'mobile'
      const [activeFileId, setActiveFileId] = useState('index-html');
      const [isChatOpen, setIsChatOpen] = useState(false);
      const [chatMessages, setChatMessages] = useState([
        { id: '1', sender: 'assistant', text: 'Welcome to VibeForge AI Assistant! I can help you refine your website layout, generate sections, or polish copy.', isSimulated: true }
      ]);
      const [chatInput, setChatInput] = useState('');
      const [isTyping, setIsTyping] = useState(false);

      // Dialog States
      const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);
      const [isSettingsOpen, setIsSettingsOpen] = useState(false);
      const [createPrompt, setCreatePrompt] = useState('');
      const [createCategory, setCreateCategory] = useState('SaaS');
      const [isCreating, setIsCreating] = useState(false);
      const [isExporting, setIsExporting] = useState(false);

      // Gemini API Settings State
      const [geminiApiKey, setGeminiApiKey] = useState(() => {
        return localStorage.getItem(API_KEY_STORAGE) || '';
      });
      const [tempApiKey, setTempApiKey] = useState(geminiApiKey);

      // Toast Notification
      const [toast, setToast] = useState(null);

      const showToast = (message, type = 'info') => {
        setToast({ message, type });
        setTimeout(() => setToast(null), 3200);
      };

      // Persist projects to localStorage automatically
      useEffect(() => {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(projects));
        } catch (err) {
          console.warn("Failed to write to localStorage:", err);
        }
      }, [projects]);

      // Filtered projects for Dashboard
      const filteredProjects = useMemo(() => {
        return projects.filter(p => {
          const matchesSearch = p.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
                                p.description.toLowerCase().includes(searchQuery.toLowerCase());
          const matchesCategory = selectedCategory === 'All' || p.category === selectedCategory;
          return matchesSearch && matchesCategory;
        });
      }, [projects, searchQuery, selectedCategory]);

      // Active File in Builder
      const activeFile = useMemo(() => {
        if (!activeProject || !activeProject.files) return null;
        return activeProject.files.find(f => f.id === activeFileId) || activeProject.files[0];
      }, [activeProject, activeFileId]);

      // Live Compiled Iframe Document (Priority 2: Dynamic Preview)
      const compiledSrcDoc = useMemo(() => {
        if (!activeProject || !activeProject.files) return SAMPLE_WEBSITE_HTML;
        
        const htmlFile = activeProject.files.find(f => f.name.endsWith('.html') || f.type === 'html') || activeProject.files[0];
        const cssFile = activeProject.files.find(f => f.name.endsWith('.css') || f.type === 'css');
        const jsFile = activeProject.files.find(f => f.name.endsWith('.js') || f.type === 'js');

        if (!htmlFile) return '<html><body><p>No HTML file found.</p></body></html>';

        let doc = htmlFile.content || '';

        // Inject custom CSS if present
        if (cssFile && cssFile.content) {
          const styleTag = `<style>\n${cssFile.content}\n</style>`;
          if (doc.includes('</head>')) {
            doc = doc.replace('</head>', `${styleTag}\n</head>`);
          } else {
            doc = `${styleTag}\n${doc}`;
          }
        }

        // Inject custom JS if present
        if (jsFile && jsFile.content) {
          const scriptTag = `<script>\ntry {\n${jsFile.content}\n} catch (e) { console.error('Website Script Error:', e); }\n<\/script>`;
          if (doc.includes('</body>')) {
            doc = doc.replace('</body>', `${scriptTag}\n</body>`);
          } else {
            doc = `${doc}\n${scriptTag}`;
          }
        }

        return doc;
      }, [activeProject]);

      // Priority 2: Update Code for active file & synchronize project
      const handleCodeChange = (newCode) => {
        if (!activeFile) return;

        const updatedFiles = activeProject.files.map(f => {
          if (f.id === activeFile.id) {
            return {
              ...f,
              content: newCode,
              lines: newCode.split('\n').length,
              size: `${(newCode.length / 1024).toFixed(1)} KB`
            };
          }
          return f;
        });

        const updatedProj = { ...activeProject, files: updatedFiles, updatedAt: 'Just now' };
        setActiveProject(updatedProj);
        setProjects(prev => prev.map(p => p.id === updatedProj.id ? updatedProj : p));
      };

      // Priority 1: Real Client-Side ZIP Export with JSZip
      const handleExportZip = async () => {
        if (!window.JSZip) {
          showToast("JSZip library is unavailable. Please check your network connection.", "error");
          return;
        }

        if (!activeProject || !activeProject.files || activeProject.files.length === 0) {
          showToast("No project files available to export.", "error");
          return;
        }

        try {
          setIsExporting(true);
          const zip = new JSZip();

          // Add each actual project file
          activeProject.files.forEach(file => {
            const cleanPath = file.path.startsWith('/') ? file.path.slice(1) : file.path;
            zip.file(cleanPath, file.content);
          });

          // Ensure README.md exists if not already present in project files
          const hasReadme = activeProject.files.some(f => f.name.toLowerCase() === 'readme.md');
          if (!hasReadme) {
            const defaultReadme = `# ${activeProject.name}\n\nGenerated with VibeForge 2.0 Full-Stack Platform.\n\n## Overview\n${activeProject.description}\n`;
            zip.file("README.md", defaultReadme);
          }

          // Generate real ZIP Blob
          const zipBlob = await zip.generateAsync({ type: "blob" });
          const url = URL.createObjectURL(zipBlob);
          const downloadAnchor = document.createElement('a');
          downloadAnchor.href = url;
          const safeSlug = (activeProject.name || 'vibeforge-site').toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-');
          downloadAnchor.download = `${safeSlug}.zip`;
          document.body.appendChild(downloadAnchor);
          downloadAnchor.click();
          document.body.removeChild(downloadAnchor);
          URL.revokeObjectURL(url);

          setIsExporting(false);
          showToast(`Exported ${safeSlug}.zip successfully!`, 'success');
        } catch (err) {
          setIsExporting(false);
          console.error("ZIP Generation Failed:", err);
          showToast(`Failed to export ZIP: ${err.message}`, 'error');
        }
      };

      // Resilient Gemini API Dispatcher (Priority 5: Tries Gemini 2.0 Flash then 1.5 Flash)
      const callGeminiEndpoint = async (apiKey, promptText) => {
        const candidateModels = ['gemini-2.0-flash', 'gemini-1.5-flash'];
        let lastErr = null;
        for (const model of candidateModels) {
          try {
            const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${encodeURIComponent(apiKey.trim())}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                contents: [{
                  parts: [{ text: promptText }]
                }]
              })
            });
            if (res.ok) {
              const data = await res.json();
              return data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
            }
            const errData = await res.json().catch(() => ({}));
            lastErr = new Error(errData?.error?.message || `HTTP ${res.status}`);
            if (res.status !== 404) {
              throw lastErr;
            }
          } catch (e) {
            lastErr = e;
            if (e.message && !e.message.includes('404')) {
              throw e;
            }
          }
        }
        throw lastErr || new Error('Gemini API endpoint unreachable');
      };

      // Priority 4 & 5: Handle Project Creation (Dynamic Template or Gemini AI)
      const handleCreateProject = async () => {
        if (createPrompt.trim().length < 10) return;
        setIsCreating(true);

        try {
          let generatedFiles = [];
          let isAIGenerated = false;

          // Priority 5: If Gemini API key is provided, attempt live LLM generation
          if (geminiApiKey.trim()) {
            try {
              const promptInstruction = `You are an expert web developer. The user wants to build a website: "${createPrompt}". Category: "${createCategory}".
Output ONLY valid JSON in this exact structure with NO markdown fences:
{
  "indexHtml": "<!DOCTYPE html><html>...</html>",
  "stylesCss": "/* styles */",
  "mainJs": "// js"
}
Ensure index.html includes Tailwind CSS via <script src="https://cdn.tailwindcss.com"><\/script> and is a modern, responsive, complete multi-section website.`;

              const rawText = await callGeminiEndpoint(geminiApiKey, promptInstruction);
              let cleanedJson = rawText.trim();
              if (cleanedJson.startsWith('```json')) cleanedJson = cleanedJson.slice(7);
              else if (cleanedJson.startsWith('```')) cleanedJson = cleanedJson.slice(3);
              if (cleanedJson.endsWith('```')) cleanedJson = cleanedJson.slice(0, -3);
              cleanedJson = cleanedJson.trim();
              const parsed = JSON.parse(cleanedJson);

              if (parsed.indexHtml) {
                generatedFiles = [
                  { id: "index-html", name: "index.html", path: "/index.html", type: "html", size: `${(parsed.indexHtml.length / 1024).toFixed(1)} KB`, lines: parsed.indexHtml.split('\n').length, content: parsed.indexHtml },
                  { id: "styles-css", name: "styles.css", path: "/styles.css", type: "css", size: `${(parsed.stylesCss.length / 1024).toFixed(1)} KB`, lines: parsed.stylesCss.split('\n').length, content: parsed.stylesCss || '/* CSS */' },
                  { id: "main-js", name: "main.js", path: "/main.js", type: "js", size: `${(parsed.mainJs.length / 1024).toFixed(1)} KB`, lines: parsed.mainJs.split('\n').length, content: parsed.mainJs || '// JS' }
                ];
                isAIGenerated = true;
              }
            } catch (aiErr) {
              console.warn("Gemini generation failed, falling back to Dynamic Template Engine:", aiErr);
              showToast(`Gemini API issue (${aiErr.message}). Using Template Synthesizer.`, 'info');
            }
          }

          // Fallback to Priority 4: Dynamic Template Engine
          if (generatedFiles.length === 0) {
            generatedFiles = synthesizeWebsite(createPrompt, createCategory);
          }

          const safeTitle = createPrompt.slice(0, 32) + (createPrompt.length > 32 ? '...' : '');
          const newProj = {
            id: 'proj-' + Date.now(),
            name: safeTitle,
            description: createPrompt,
            category: createCategory,
            updatedAt: 'Just now',
            isDemo: false,
            isAIGenerated: isAIGenerated,
            accentColor: 'from-violet-600 to-electric-500',
            files: generatedFiles
          };

          const nextProjects = [newProj, ...projects];
          setProjects(nextProjects);
          setActiveProject(newProj);
          setActiveFileId('index-html');
          setIsCreating(false);
          setIsCreateModalOpen(false);
          setCreatePrompt('');
          setActiveView('builder');
          showToast(isAIGenerated ? 'Website synthesized via Gemini AI!' : 'Website synthesized via Template Engine!', 'success');
        } catch (error) {
          setIsCreating(false);
          showToast(`Error creating project: ${error.message}`, 'error');
        }
      };

      // AI Chat refinement (Simulation or Real Gemini if key available)
      const handleSendChatMessage = async (textToSend) => {
        const query = textToSend || chatInput;
        if (!query.trim()) return;

        const userMsg = { id: Date.now().toString(), sender: 'user', text: query, isSimulated: false };
        setChatMessages(prev => [...prev, userMsg]);
        setChatInput('');
        setIsTyping(true);

        if (geminiApiKey.trim()) {
          try {
            const chatPrompt = `You are an AI assistant inside VibeForge, helping the user edit their website. The user says: "${query}". Provide a concise, helpful response (max 3 sentences) explaining how you can assist or suggest code edits.`;
            const reply = await callGeminiEndpoint(geminiApiKey, chatPrompt);
            setIsTyping(false);
            setChatMessages(prev => [...prev, { id: Date.now().toString(), sender: 'assistant', text: reply || 'I can assist you with editing your code.', isSimulated: false }]);
            return;
          } catch (e) {
            console.warn("Chat API error:", e);
          }
        }

        // Simulated Fallback
        setTimeout(() => {
          setIsTyping(false);
          const aiResponse = {
            id: (Date.now() + 1).toString(),
            sender: 'assistant',
            text: `[Template Assistant]: Received instruction to "${query}". You can edit the code directly in the Code panel, or configure your Gemini API Key in Settings for live AI generation.`,
            isSimulated: true
          };
          setChatMessages(prev => [...prev, aiResponse]);
        }, 800);
      };

      // Copy Code Action
      const handleCopyCode = () => {
        if (!activeFile) return;
        navigator.clipboard.writeText(activeFile.content)
          .then(() => showToast(`Copied ${activeFile.name} to clipboard!`, 'success'))
          .catch(() => showToast('Clipboard permission denied', 'error'));
      };

      // Reset to Defaults (Priority 3: Project Management)
      const handleResetDefaults = () => {
        if (confirm("Reset projects to default demo templates? This will clear custom projects saved in this browser.")) {
          localStorage.removeItem(STORAGE_KEY);
          setProjects(DEFAULT_PROJECTS);
          setActiveProject(DEFAULT_PROJECTS[0]);
          showToast("Restored default demo projects", "info");
        }
      };

      // Save API Key
      const handleSaveApiKey = () => {
        const clean = tempApiKey.trim();
        setGeminiApiKey(clean);
        if (clean) {
          localStorage.setItem(API_KEY_STORAGE, clean);
          showToast("Gemini API Key saved in local browser storage", "success");
        } else {
          localStorage.removeItem(API_KEY_STORAGE);
          showToast("API Key removed; using local template engine", "info");
        }
        setIsSettingsOpen(false);
      };

      return (
        <div className="min-h-screen bg-[#0b0d13] text-slate-100 flex flex-col">
          
          {/* Toast Notification */}
          {toast && (
            <div className={`fixed bottom-6 right-6 z-50 flex items-center gap-3 px-4 py-3 rounded-xl border shadow-2xl text-sm font-medium animate-bounce ${
              toast.type === 'error' ? 'bg-rose-950/90 border-rose-500 text-rose-200' :
              toast.type === 'success' ? 'bg-emerald-950/90 border-emerald-500 text-emerald-200' :
              'bg-charcoal-800 border-violet-500/40 text-slate-100'
            }`}>
              <span className={`w-2 h-2 rounded-full ${toast.type === 'error' ? 'bg-rose-400' : toast.type === 'success' ? 'bg-emerald-400' : 'bg-violet-400'}`}></span>
              {toast.message}
            </div>
          )}

          {/* Top Application Header */}
          <header className="h-16 border-b border-white/10 bg-charcoal-900/90 backdrop-blur-md sticky top-0 z-40 px-4 sm:px-6 flex items-center justify-between">
            <div className="flex items-center gap-4">
              <button 
                onClick={() => setActiveView('dashboard')}
                className="flex items-center gap-2.5 group focus:outline-none"
              >
                <div className="w-9 h-9 rounded-xl bg-gradient-to-tr from-violet-600 via-blue-600 to-cyan-500 flex items-center justify-center shadow-lg shadow-violet-500/20 group-hover:scale-105 transition-transform">
                  <Icons.Logo />
                </div>
                <div className="text-left">
                  <div className="font-extrabold text-lg tracking-tight flex items-center gap-2">
                    <span className="brand-gradient-text">VibeForge</span>
                    <span className="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-violet-500/20 border border-violet-500/30 text-violet-300">
                      v2.0 Phase 2
                    </span>
                  </div>
                </div>
              </button>

              {activeView === 'builder' && (
                <div className="hidden sm:flex items-center gap-2 text-xs text-slate-400 pl-4 border-l border-white/10">
                  <button onClick={() => setActiveView('dashboard')} className="hover:text-white transition-colors">
                    Dashboard
                  </button>
                  <span>/</span>
                  <span className="text-slate-200 font-semibold truncate max-w-[200px]">
                    {activeProject?.name}
                  </span>
                </div>
              )}
            </div>

            <div className="flex items-center gap-3">
              {/* Settings / API Key button */}
              <button
                onClick={() => { setTempApiKey(geminiApiKey); setIsSettingsOpen(true); }}
                title="API Settings (Gemini AI)"
                className="p-2 rounded-lg bg-charcoal-800 hover:bg-charcoal-700 border border-white/10 text-slate-300 text-xs flex items-center gap-1.5 transition-all"
              >
                <Icons.Settings />
                <span className="hidden sm:inline">{geminiApiKey ? 'Gemini Active' : 'AI Settings'}</span>
                {geminiApiKey && <span className="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>}
              </button>

              {activeView === 'dashboard' ? (
                <button
                  onClick={() => setIsCreateModalOpen(true)}
                  className="px-4 py-2 rounded-lg btn-gradient text-white text-xs sm:text-sm font-semibold flex items-center gap-2 shadow-lg"
                >
                  <Icons.Plus />
                  <span>Create New Website</span>
                </button>
              ) : (
                <button
                  onClick={() => setActiveView('dashboard')}
                  className="px-3.5 py-1.5 rounded-lg border border-white/10 hover:border-white/20 bg-charcoal-800 text-slate-300 text-xs font-semibold flex items-center gap-1.5 transition-all"
                >
                  <Icons.Back />
                  <span>Dashboard</span>
                </button>
              )}
            </div>
          </header>

          {/* MAIN CONTENT ROUTER */}
          <main className="flex-1 flex flex-col">
            {activeView === 'dashboard' ? (
              /* ================== REFERENCE DASHBOARD VIEW ================== */
              <ReferenceDashboard
                projects={projects}
                isGenerating={isCreating}
                onGenerate={(prompt) => {
                  if (prompt.trim().length < 10) return;
                  setCreatePrompt(prompt);
                  setCreateCategory('SaaS');
                  setIsCreateModalOpen(true);
                }}
                onUseTemplate={(tmpl) => {
                  if (isCreating) return;
                  setIsCreating(true);
                  setTimeout(() => {
                    try {
                      const files = synthesizeWebsite(tmpl.prompt, tmpl.category);
                      const newProj = {
                        id: 'proj-' + Date.now(),
                        name: tmpl.title,
                        description: tmpl.prompt,
                        category: tmpl.category,
                        updatedAt: 'Just now',
                        isDemo: false,
                        isAIGenerated: false,
                        accentColor: tmpl.accent || 'from-violet-600 to-blue-500',
                        files
                      };
                      setProjects(prev => [newProj, ...prev]);
                      setActiveProject(newProj);
                      setActiveFileId('index-html');
                      setIsCreating(false);
                      setActiveView('builder');
                      showToast('"' + tmpl.title + '" loaded!', 'success');
                    } catch(e) {
                      setIsCreating(false);
                      showToast('Template error: ' + e.message, 'error');
                    }
                  }, 0);
                }}
                onOpenProject={(proj) => { setActiveProject(proj); setActiveView('builder'); }}
                onCreateNew={() => setIsCreateModalOpen(true)}
                onSettings={() => { setTempApiKey(geminiApiKey); setIsSettingsOpen(true); }}
              />
            ) : (
              /* ================== BUILDER VIEW ==================== */
              <div className="flex-1 flex flex-col h-[calc(100vh-64px)] overflow-hidden">
                
                {/* Builder Top Toolbar */}
                <div className="h-14 border-b border-white/10 bg-charcoal-900 px-4 flex items-center justify-between gap-4">
                  
                  {/* Left: Project Info & Save Status */}
                  <div className="flex items-center gap-3">
                    <span className="font-semibold text-sm text-white truncate max-w-[180px] sm:max-w-[280px]">
                      {activeProject?.name}
                    </span>
                    <span className="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/10 border border-emerald-500/25 text-emerald-300">
                      <span className="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      Saved to Browser
                    </span>
                  </div>

                  {/* Center: Viewport Controls & View Mode Tabs */}
                  <div className="flex items-center gap-3">
                    
                    {/* Viewport Switcher */}
                    <div className="bg-charcoal-800 p-0.5 rounded-lg border border-white/10 flex items-center">
                      <button
                        onClick={() => { setViewport('desktop'); showToast('Viewport: Desktop (100%)'); }}
                        title="Desktop View (100%)"
                        className={`p-1.5 rounded-md text-xs font-medium transition-all ${
                          viewport === 'desktop' ? 'bg-violet-600 text-white' : 'text-slate-400 hover:text-white'
                        }`}
                      >
                        <Icons.Desktop />
                      </button>
                      <button
                        onClick={() => { setViewport('tablet'); showToast('Viewport: Tablet (768px)'); }}
                        title="Tablet View (768px)"
                        className={`p-1.5 rounded-md text-xs font-medium transition-all ${
                          viewport === 'tablet' ? 'bg-violet-600 text-white' : 'text-slate-400 hover:text-white'
                        }`}
                      >
                        <Icons.Tablet />
                      </button>
                      <button
                        onClick={() => { setViewport('mobile'); showToast('Viewport: Mobile (375px)'); }}
                        title="Mobile View (375px)"
                        className={`p-1.5 rounded-md text-xs font-medium transition-all ${
                          viewport === 'mobile' ? 'bg-violet-600 text-white' : 'text-slate-400 hover:text-white'
                        }`}
                      >
                        <Icons.Mobile />
                      </button>
                    </div>

                    {/* View Switcher Tabs */}
                    <div className="bg-charcoal-800 p-0.5 rounded-lg border border-white/10 flex items-center text-xs">
                      <button
                        onClick={() => setActiveTab('preview')}
                        className={`px-3 py-1 rounded-md font-medium flex items-center gap-1.5 transition-all ${
                          activeTab === 'preview' ? 'bg-violet-600 text-white' : 'text-slate-400 hover:text-white'
                        }`}
                      >
                        <Icons.Eye />
                        <span className="hidden md:inline">Preview</span>
                      </button>
                      <button
                        onClick={() => setActiveTab('code')}
                        className={`px-3 py-1 rounded-md font-medium flex items-center gap-1.5 transition-all ${
                          activeTab === 'code' ? 'bg-violet-600 text-white' : 'text-slate-400 hover:text-white'
                        }`}
                      >
                        <Icons.Code />
                        <span className="hidden md:inline">Code (Edit)</span>
                      </button>
                      <button
                        onClick={() => setActiveTab('split')}
                        className={`hidden lg:flex px-3 py-1 rounded-md font-medium items-center gap-1.5 transition-all ${
                          activeTab === 'split' ? 'bg-violet-600 text-white' : 'text-slate-400 hover:text-white'
                        }`}
                      >
                        <span>Split</span>
                      </button>
                    </div>
                  </div>

                  {/* Right: AI Chat Toggle & Real ZIP Export Action */}
                  <div className="flex items-center gap-2">
                    <button
                      onClick={() => setIsChatOpen(!isChatOpen)}
                      className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-2 transition-all ${
                        isChatOpen 
                          ? 'bg-violet-600 text-white shadow-md'
                          : 'bg-charcoal-800 border border-white/10 hover:border-violet-500/50 text-slate-300'
                      }`}
                    >
                      <Icons.Chat />
                      <span className="hidden sm:inline">AI Assistant</span>
                    </button>

                    {/* Priority 1: Real Downloadable ZIP Export */}
                    <button
                      onClick={handleExportZip}
                      disabled={isExporting}
                      className="px-3.5 py-1.5 rounded-lg btn-gradient text-white text-xs font-semibold flex items-center gap-1.5 shadow-md disabled:opacity-50"
                    >
                      <Icons.Download />
                      <span>{isExporting ? 'Packaging...' : 'Export ZIP'}</span>
                    </button>
                  </div>
                </div>

                {/* 3-Column IDE Workspace Body */}
                <div className="flex-1 flex overflow-hidden">
                  
                  {/* Left Column: File Explorer */}
                  <div className="w-56 border-r border-white/10 bg-charcoal-950 flex flex-col">
                    <div className="p-3 border-b border-white/10 flex items-center justify-between text-xs font-bold text-slate-400 uppercase tracking-wider">
                      <span className="flex items-center gap-2">
                        <Icons.Folder /> Files
                      </span>
                      <span className="text-[10px] text-slate-500 font-mono">
                        {activeProject?.files?.length || 0}
                      </span>
                    </div>

                    <div className="p-2 space-y-1 overflow-y-auto flex-1">
                      {activeProject?.files?.map(file => (
                        <button
                          key={file.id}
                          onClick={() => {
                            setActiveFileId(file.id);
                            if (activeTab === 'preview') setActiveTab('code');
                            showToast(`Editing ${file.name}`);
                          }}
                          className={`w-full text-left px-2.5 py-1.5 rounded-lg text-xs font-mono flex items-center justify-between transition-all ${
                            activeFileId === file.id
                              ? 'bg-violet-600/20 text-violet-300 border border-violet-500/30 font-semibold'
                              : 'text-slate-400 hover:text-slate-200 hover:bg-white/5'
                          }`}
                        >
                          <span className="flex items-center gap-2 truncate">
                            <span className={`px-1.5 py-0.5 rounded text-[9px] font-mono font-bold uppercase tracking-wider ${
                              file.name.endsWith('.html') ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30' :
                              file.name.endsWith('.css') ? 'bg-sky-500/15 text-sky-300 border border-sky-500/30' :
                              file.name.endsWith('.sql') ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/30' :
                              file.name.endsWith('manifest.json') ? 'bg-violet-500/15 text-violet-300 border border-violet-500/30' :
                              file.name === 'server.js' ? 'bg-purple-500/15 text-purple-300 border border-purple-500/30' :
                              file.name.endsWith('.js') ? 'bg-amber-500/15 text-amber-300 border border-amber-500/30' :
                              file.name.endsWith('.json') ? 'bg-rose-500/15 text-rose-300 border border-rose-500/30' :
                              file.name.endsWith('.md') ? 'bg-indigo-500/15 text-indigo-300 border border-indigo-500/30' :
                              'bg-slate-500/15 text-slate-300 border border-slate-500/30'
                            }`}>
                              {file.name.endsWith('manifest.json') ? 'SPEC' :
                               file.name === 'server.js' ? 'API' :
                               file.name.endsWith('.html') ? 'HTML' :
                               file.name.endsWith('.css') ? 'CSS' :
                               file.name.endsWith('.sql') ? 'SQL' :
                               file.name.endsWith('.js') ? 'JS' :
                               file.name.endsWith('.json') ? 'PKG' :
                               file.name.endsWith('.md') ? 'DOC' : 'CFG'}
                            </span>
                            <span className="truncate">{file.name}</span>
                          </span>
                          <span className="text-[10px] text-slate-500">
                            {file.size}
                          </span>
                        </button>
                      ))}
                    </div>

                    <div className="p-3 border-t border-white/5 bg-charcoal-900/50 text-[11px] text-slate-400 flex items-center justify-between">
                      <span>Live Sync: Active</span>
                      <span className="text-emerald-400">● Synced</span>
                    </div>
                  </div>

                  {/* Center Column: Dynamic Workspace Canvas */}
                  <div className="flex-1 bg-charcoal-900/70 flex flex-col overflow-hidden relative">
                    
                    {/* View Mode Conditionals */}
                    {(activeTab === 'preview' || activeTab === 'split') && (
                      <div className={`flex-1 flex items-center justify-center p-3 sm:p-6 overflow-auto bg-[#07090e] ${activeTab === 'split' ? 'w-1/2 border-r border-white/10' : 'w-full'}`}>
                        
                        {/* Viewport Constrained Container */}
                        <div className={`h-full transition-all duration-300 ease-out flex flex-col shadow-2xl ${
                          viewport === 'desktop' ? 'w-full max-w-6xl' :
                          viewport === 'tablet' ? 'w-[768px] max-w-full rounded-2xl border-4 border-slate-700 overflow-hidden' :
                          'w-[375px] max-w-full rounded-[36px] border-[6px] border-slate-700 overflow-hidden relative'
                        }`}>
                          
                          {/* Device Frame Notch (Mobile Mode) */}
                          {viewport === 'mobile' && (
                            <div className="h-5 bg-slate-800 flex items-center justify-center">
                              <div className="w-20 h-3 bg-black rounded-full"></div>
                            </div>
                          )}

                          {/* Priority 2: Isolated Preview Iframe bound to compiledSrcDoc */}
                          <iframe
                            id="preview-canvas-iframe"
                            sandbox="allow-scripts allow-forms"
                            srcDoc={compiledSrcDoc}
                            title="Website Preview"
                            className="w-full flex-1 border-0 bg-white"
                          />
                        </div>
                      </div>
                    )}

                    {/* Priority 2: In-Browser Editable Code Panel */}
                    {(activeTab === 'code' || activeTab === 'split') && (
                      <div className={`flex-1 flex flex-col bg-charcoal-950 overflow-hidden ${activeTab === 'split' ? 'w-1/2' : 'w-full'}`}>
                        
                        {/* Code Header Bar */}
                        <div className="h-10 border-b border-white/10 px-4 flex items-center justify-between bg-charcoal-900 text-xs">
                          <div className="flex items-center gap-3">
                            <span className="font-mono text-violet-300 font-semibold">{activeFile?.name}</span>
                            <span className="text-[10px] text-slate-500 font-mono">{activeFile?.lines} lines • {activeFile?.size}</span>
                          </div>
                          <div className="flex items-center gap-2">
                            <span className="text-[10px] text-emerald-400 font-mono hidden sm:inline">Edits update preview instantly</span>
                            <button
                              onClick={handleCopyCode}
                              className="px-2.5 py-1 rounded bg-charcoal-800 hover:bg-charcoal-700 text-slate-300 text-xs flex items-center gap-1.5 transition-all"
                            >
                              <Icons.Copy />
                              <span>Copy Code</span>
                            </button>
                          </div>
                        </div>

                        {/* Interactive Code Editor (Synchronized with activeProject state) */}
                        <div className="flex-1 flex overflow-hidden p-2 bg-[#0c0e17]">
                          <textarea
                            value={activeFile?.content || ''}
                            onChange={(e) => handleCodeChange(e.target.value)}
                            spellCheck="false"
                            className="w-full h-full p-3 bg-transparent text-slate-100 code-font text-xs leading-relaxed resize-none border-0 focus:outline-none focus:ring-1 focus:ring-violet-500/50 rounded-lg selection:bg-violet-700"
                            placeholder="Type code here..."
                          />
                        </div>
                      </div>
                    )}
                  </div>

                  {/* Right Column: AI Chat Panel */}
                  {isChatOpen && (
                    <div className="w-80 lg:w-96 border-l border-white/10 bg-charcoal-950 flex flex-col h-full shadow-2xl animate-in slide-in-from-right duration-200">
                      
                      {/* Chat Header */}
                      <div className="p-3 border-b border-white/10 flex items-center justify-between">
                        <div className="flex items-center gap-2">
                          <div className="w-6 h-6 rounded-lg bg-violet-600 flex items-center justify-center text-white">
                            <Icons.Sparkles />
                          </div>
                          <span className="font-semibold text-xs text-white">VibeForge Assistant</span>
                          <span className="text-[10px] px-1.5 py-0.5 rounded bg-violet-500/10 text-violet-300 border border-violet-500/20">
                            {geminiApiKey ? 'Gemini AI' : 'Template'}
                          </span>
                        </div>
                        <button
                          onClick={() => setIsChatOpen(false)}
                          className="text-slate-400 hover:text-white p-1 rounded"
                        >
                          <Icons.Close />
                        </button>
                      </div>

                      {/* Chat Messages List */}
                      <div className="flex-1 p-3 overflow-y-auto space-y-3">
                        {chatMessages.map(msg => (
                          <div
                            key={msg.id}
                            className={`flex flex-col ${msg.sender === 'user' ? 'items-end' : 'items-start'}`}
                          >
                            <div className={`p-3 rounded-xl text-xs max-w-[88%] leading-relaxed ${
                              msg.sender === 'user'
                                ? 'bg-violet-600 text-white rounded-br-none'
                                : 'bg-charcoal-800 border border-white/10 text-slate-200 rounded-bl-none'
                            }`}>
                              {msg.text}
                            </div>
                            <span className="text-[10px] text-slate-500 mt-1 px-1">
                              {msg.sender === 'user' ? 'You' : 'Assistant'}
                            </span>
                          </div>
                        ))}

                        {isTyping && (
                          <div className="flex items-center gap-1.5 p-3 rounded-xl bg-charcoal-800 text-slate-400 text-xs w-20">
                            <span className="w-1.5 h-1.5 rounded-full bg-violet-400 animate-pulse"></span>
                            <span className="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse delay-100"></span>
                            <span className="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse delay-200"></span>
                          </div>
                        )}
                      </div>

                      {/* Quick Prompt Suggestions */}
                      <div className="p-2 border-t border-white/5 bg-charcoal-900/60">
                        <div className="text-[10px] uppercase font-semibold text-slate-400 mb-1.5 px-1">
                          Quick Suggestions
                        </div>
                        <div className="space-y-1">
                          {[
                            'Add a modern pricing table with 3 tiers',
                            'Change hero headline to bold emerald',
                            'Add customer testimonial cards'
                          ].map((suggestion, idx) => (
                            <button
                              key={idx}
                              onClick={() => handleSendChatMessage(suggestion)}
                              className="w-full text-left px-2 py-1 rounded bg-charcoal-800 hover:bg-violet-900/40 text-[11px] text-slate-300 hover:text-violet-200 truncate transition-colors border border-white/5"
                            >
                              + {suggestion}
                            </button>
                          ))}
                        </div>
                      </div>

                      {/* Chat Input Bar */}
                      <div className="p-3 border-t border-white/10 flex items-center gap-2">
                        <input
                          type="text"
                          value={chatInput}
                          onChange={e => setChatInput(e.target.value)}
                          onKeyDown={e => e.key === 'Enter' && handleSendChatMessage()}
                          placeholder="Ask assistant to refine website..."
                          className="flex-1 px-3 py-2 text-xs rounded-lg bg-charcoal-800 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-violet-500"
                        />
                        <button
                          onClick={() => handleSendChatMessage()}
                          className="px-3 py-2 rounded-lg btn-gradient text-white text-xs font-semibold shadow"
                        >
                          Send
                        </button>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            )}
          </main>

          {/* ================== CREATE WEBSITE MODAL ================== */}
          {isCreateModalOpen && (
            <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200">
              <div className="w-full max-w-xl rounded-2xl glass-panel p-6 shadow-2xl border border-white/15 relative">
                
                <div className="flex items-center justify-between pb-4 border-b border-white/10 mb-5">
                  <div className="flex items-center gap-2.5">
                    <div className="w-8 h-8 rounded-lg bg-violet-600 flex items-center justify-center text-white">
                      <Icons.Sparkles />
                    </div>
                    <div>
                      <h2 className="text-base font-bold text-white">Describe Your Website</h2>
                      <p className="text-xs text-slate-400">Natural language website generation prompt</p>
                    </div>
                  </div>
                  <button
                    onClick={() => setIsCreateModalOpen(false)}
                    className="text-slate-400 hover:text-white"
                  >
                    <Icons.Close />
                  </button>
                </div>

                {/* Generator Notice */}
                <div className="p-3 rounded-lg bg-violet-500/10 border border-violet-500/25 text-xs text-violet-300 mb-4 flex items-center gap-2">
                  <span className="w-2 h-2 rounded-full bg-violet-400"></span>
                  <span><strong>Generator:</strong> {geminiApiKey ? 'Gemini 2.0 / 1.5 Flash (Direct API)' : 'Dynamic Template Engine (Zero Cost / No Key)'}</span>
                </div>

                {/* Prompt Textarea */}
                <div className="mb-4">
                  <div className="flex items-center justify-between text-xs font-semibold text-slate-300 mb-1.5">
                    <label>Website Description</label>
                    <span className={`text-[11px] ${createPrompt.length >= 10 ? 'text-emerald-400' : 'text-slate-500'}`}>
                      {createPrompt.length} / 10 min chars
                    </span>
                  </div>
                  <textarea
                    rows="4"
                    value={createPrompt}
                    onChange={e => setCreatePrompt(e.target.value)}
                    placeholder="e.g., A specialty single-origin coffee shop with dark warm aesthetics, menu cards, tasting notes, and a contact form..."
                    className="w-full px-3.5 py-2.5 text-xs rounded-xl bg-charcoal-900 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-violet-500 leading-relaxed"
                  />
                  {createPrompt.length > 0 && createPrompt.length < 10 && (
                    <div className="text-[11px] text-rose-400 mt-1">
                      Please enter at least 10 characters to describe your website.
                    </div>
                  )}
                </div>

                {/* Quick Presets */}
                <div className="mb-4">
                  <div className="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-2">
                    Quick Preset Prompts:
                  </div>
                  <div className="flex flex-wrap gap-1.5">
                    {PROMPT_PRESETS.map((preset, idx) => (
                      <button
                        key={idx}
                        onClick={() => {
                          setCreatePrompt(preset.prompt);
                          setCreateCategory(preset.category);
                        }}
                        className="px-2.5 py-1 rounded-lg text-xs bg-charcoal-800 hover:bg-violet-900/40 border border-white/5 text-slate-300 hover:text-white transition-colors"
                      >
                        ⚡ {preset.label}
                      </button>
                    ))}
                  </div>
                </div>

                {/* Category Selector */}
                <div className="mb-6">
                  <label className="block text-xs font-semibold text-slate-300 mb-1.5">Category</label>
                  <select
                    value={createCategory}
                    onChange={e => setCreateCategory(e.target.value)}
                    className="w-full px-3 py-2 text-xs rounded-lg bg-charcoal-900 border border-white/10 text-white focus:outline-none focus:border-violet-500"
                  >
                    <option value="SaaS">SaaS Platform</option>
                    <option value="Portfolio">Developer / Designer Portfolio</option>
                    <option value="Landing Page">Product Landing Page</option>
                    <option value="E-Commerce">E-Commerce Store</option>
                    <option value="Agency">Agency & Studio</option>
                  </select>
                </div>

                {/* Actions */}
                <div className="flex items-center justify-end gap-3 pt-3 border-t border-white/10">
                  <button
                    onClick={() => setIsCreateModalOpen(false)}
                    className="px-4 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white"
                  >
                    Cancel
                  </button>
                  <button
                    onClick={handleCreateProject}
                    disabled={createPrompt.trim().length < 10 || isCreating}
                    className="px-5 py-2.5 rounded-lg btn-gradient text-white text-xs font-bold disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-2 shadow-lg"
                  >
                    {isCreating ? (
                      <>
                        <span className="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                        <span>Synthesizing Website...</span>
                      </>
                    ) : (
                      <>
                        <Icons.Sparkles />
                        <span>Generate Website</span>
                      </>
                    )}
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* ================== PRIORITY 5: API SETTINGS MODAL ================== */}
          {isSettingsOpen && (
            <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200">
              <div className="w-full max-w-lg rounded-2xl glass-panel p-6 shadow-2xl border border-white/15">
                <div className="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
                  <div className="flex items-center gap-2.5">
                    <div className="w-8 h-8 rounded-lg bg-blue-600/30 text-blue-400 flex items-center justify-center">
                      <Icons.Settings />
                    </div>
                    <div>
                      <h3 className="text-base font-bold text-white">AI Engine Settings</h3>
                      <p className="text-xs text-slate-400">Configure optional Google Gemini API key</p>
                    </div>
                  </div>
                  <button onClick={() => setIsSettingsOpen(false)} className="text-slate-400 hover:text-white">
                    <Icons.Close />
                  </button>
                </div>

                <div className="space-y-4 mb-6">
                  <div>
                    <label className="block text-xs font-semibold text-slate-300 mb-1">
                      Gemini API Key (Optional)
                    </label>
                    <input
                      type="password"
                      value={tempApiKey}
                      onChange={e => setTempApiKey(e.target.value)}
                      placeholder="AIzaSy..."
                      className="w-full px-3 py-2 text-xs rounded-lg bg-charcoal-900 border border-white/10 text-white focus:outline-none focus:border-violet-500 font-mono"
                    />
                    <p className="text-[11px] text-slate-400 mt-1">
                      Get a free key from <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noreferrer" className="text-violet-400 underline">Google AI Studio</a> (Supports Gemini 2.0/1.5 Flash on free tier, no credit card required).
                    </p>
                  </div>

                  {/* Security & Privacy Disclosure */}
                  <div className="p-3 rounded-lg bg-amber-500/10 border border-amber-500/20 text-[11px] text-amber-300 space-y-1">
                    <div className="font-bold flex items-center gap-1.5">
                      <span>⚠️ Client-Side Security Disclosure</span>
                    </div>
                    <p className="text-slate-300 leading-relaxed">
                      API keys entered here execute direct REST calls from your browser to Google's API. Keys are stored only in your browser's local storage and are <strong>never</strong> transmitted to VibeForge servers, logged, or included in exported ZIP files.
                    </p>
                    <p className="text-slate-400">
                      If left blank, VibeForge continues to use the built-in <strong>Dynamic Template Synthesizer</strong> at zero cost.
                    </p>
                  </div>
                </div>

                <div className="flex items-center justify-end gap-3 pt-3 border-t border-white/10">
                  <button
                    onClick={() => setIsSettingsOpen(false)}
                    className="px-4 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white"
                  >
                    Cancel
                  </button>
                  <button
                    onClick={handleSaveApiKey}
                    className="px-5 py-2 rounded-lg btn-gradient text-white text-xs font-bold shadow"
                  >
                    Save Preferences
                  </button>
                </div>
              </div>
            </div>
          )}

        </div>
      );
    }

    // Mount Root Component
    const rootElement = document.getElementById('root');
    ReactDOM.createRoot(rootElement).render(<App />);
  </script>
</body>
</html>
