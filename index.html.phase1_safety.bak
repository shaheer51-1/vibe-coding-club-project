}

// Validation Utility for VibeForge Virtual File Trees
function validateProjectFiles(files) {
  const issues = [];
  if (!Array.isArray(files) || files.length === 0) {
    return { isValid: false, issues: [{ file: 'root', message: 'Project contains no files.' }] };
  }

  const hasIndexHtml = files.some(f => f.name === 'index.html' && f.content && f.content.includes('<!DOCTYPE html>'));
  if (!hasIndexHtml) {
    issues.push({ file: 'index.html', message: 'Missing valid HTML5 index.html entrypoint.' });
  }

  files.forEach(f => {
    if (!f.path || !f.path.startsWith('/')) {
      issues.push({ file: f.name, message: `Path must start with leading slash: ${f.path}` });
    }
    if (f.path && f.path.includes('..')) {
      issues.push({ file: f.name, message: `Directory traversal forbidden: ${f.path}` });
    }
    if (f.name.endsWith('.json')) {
      try {
        JSON.parse(f.content);
      } catch (err) {
        issues.push({ file: f.name, message: `Invalid JSON syntax: ${err.message}` });
      }
    }
  });

  return {
    isValid: issues.length === 0,
    issues: issues
  };
    }

