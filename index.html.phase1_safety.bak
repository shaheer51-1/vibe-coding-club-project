      { val: "14", label: "Pulitzer Nominees" },
      { val: "Zero", label: "Display Ads" }
    ];
    entityName = "articles";
  } else if (archetype === 'dashboard') {
    brandName = "Velox Cloud Telemetry";
    targetAudience = "DevOps Engineers, Site Reliability Engineers & Infrastructure Leads";
    conversionGoal = "Deploy Monitoring Agent";
    headline = "Distributed Infrastructure Monitoring with Real-Time Anomaly Detection";
    subheadline = "Unify cluster logs, eBPF network telemetry, and distributed tracing in a single ultra-responsive interface.";
    badgeText = "Cluster Agent v3.4 Active";
    navLinks = [
      { label: "Monitors", href: "#features" },
      { label: "Live Telemetry", href: "#interactive" },
      { label: "SLA Metrics", href: "#metrics" },
      { label: "Deploy", href: "#contact" }
    ];
    featureCards = [
      { title: "Kernel-Level eBPF", desc: "Zero-overhead packet inspection capturing microsecond socket drops directly in the Linux kernel.", icon: "⚡" },
      { title: "Automated Root-Cause", desc: "Graph correlation engine isolates cascading failure blast radiuses across Kubernetes pods.", icon: "🔍" },
      { title: "Cost Attribution", desc: "Per-namespace and per-query cloud expenditure tracking updated every 10 seconds.", icon: "💰" }
    ];
    stats = [
      { val: "1.2M", label: "Metrics / Sec" },
      { val: "< 3ms", label: "Query Execution" },
      { val: "99.999%", label: "Pipeline SLA" },
      { val: "100+", label: "Native Integrations" }
    ];
    entityName = "telemetry_logs";
  }

  // Attempt to extract title from prompt if provided
  const words = promptText.trim().split(/\s+/).slice(0, 4).join(" ");
  const customTitle = words.length > 5 ? words.charAt(0).toUpperCase() + words.slice(1) : brandName;
  const projectSlug = brandName.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');

  // 3. Build Project Specification Manifest (vibeforge.manifest.json)
  const manifestObj = {
    schemaVersion: "2.0.0",
    projectId: `proj-${projectSlug}-${Date.now().toString().slice(-4)}`,
    title: customTitle,
    brandName: brandName,
    archetype: archetype,
    category: category,
    brief: promptText,
    targetAudience: targetAudience,
    conversionGoal: conversionGoal,
    designSystem: {
      primaryColor: primaryColor,
      secondaryColor: secondaryColor,
      accentName: accentName,
      bgDark: bgDark,
      surfaceDark: surfaceDark,
      surfaceCard: surfaceCard,
      fontSans: "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
      fontMono: "JetBrains Mono, monospace"
    },
    sitemap: [
      { path: "/", title: "Home", sections: ["header", "hero", "features", "interactive", "metrics", "contact", "footer"] },
      { path: "/pages/about.html", title: "About", sections: ["header", "mission", "team", "footer"] }
    ],
    apiEndpoints: [
      { method: "GET", path: "/health", description: "Health check and system uptime" },
      { method: "GET", path: "/api/v1/meta", description: "Project metadata and configuration" },
      { method: "POST", path: "/api/v1/inquiries", description: "Submit lead inquiry or contact message" },
      { method: "GET", path: `/api/v1/${entityName}`, description: `Retrieve ${entityName} records` }
    ],
    databaseEntities: [
      { table: "inquiries", fields: ["id", "created_at", "name", "email", "message", "status"] },
      { table: entityName, fields: ["id", "created_at", "title", "metadata", "status"] }
    ],
    acceptanceCriteria: [
      "Semantic HTML5 layout with proper header, main, section, and footer elements",
      "Tailwind CSS styling with responsive breakpoints for desktop, tablet, and mobile",
      "Interactive widgets (calculators/filters) respond without page refresh",
      "Contact form validates inputs and submits via mock API or live backend",
      "Express REST API server with CORS and error handling",
      "PostgreSQL schema with Row-Level Security enabled",
      "Zero secret leakage in client code or manifests"
    ]
  };

  const manifestJson = JSON.stringify(manifestObj, null, 2);

  // 4. Generate Semantic Accessible HTML (index.html)
  const indexHtml = `<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="${subheadline}">
  <meta property="og:title" content="${customTitle} — ${brandName}">
  <meta property="og:description" content="${subheadline}">
  <meta property="og:type" content="website">
  <title>${customTitle} — ${brandName}</title>

  <!-- JSON-LD Structured Data Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "${brandName}",
    "headline": "${headline}",
    "description": "${subheadline}"
  }
  <\/script>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"><\/script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              primary: '${primaryColor}',
              secondary: '${secondaryColor}',
              bg: '${bgDark}',
              surface: '${surfaceDark}',
              card: '${surfaceCard}'
            }
          }
        }
      }
    }
  <\/script>
  
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body class="min-h-screen flex flex-col bg-[#0b0f19] text-slate-100 font-sans selection:bg-${accentName}-500 selection:text-white antialiased">

  <!-- Header -->
  <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0b0f19]/85 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <a href="#" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-${accentName}-400 rounded-lg p-1">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-${accentName}-600 to-sky-500 flex items-center justify-center font-bold text-white shadow-lg group-hover:scale-105 transition-transform">
          ${brandName.charAt(0)}
        </div>
        <span class="font-bold text-lg text-white tracking-tight">${brandName}</span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300" aria-label="Main Navigation">
        ${navLinks.map(n => `<a href="${n.href}" class="hover:text-white transition-colors py-1">${n.label}</a>`).join('\n        ')}
        <a href="pages/about.html" class="hover:text-white transition-colors py-1">About</a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="#contact" class="hidden sm:inline-block px-4 py-2 text-xs font-semibold rounded-lg bg-gradient-to-r from-${accentName}-600 to-sky-600 text-white hover:opacity-95 shadow-md shadow-${accentName}-600/20 transition-all focus:outline-none focus:ring-2 focus:ring-${accentName}-400">
          ${conversionGoal}
        </a>
        <!-- Mobile Navigation Hamburger -->
        <button id="mobileMenuBtn" aria-label="Toggle Navigation Menu" aria-expanded="false" class="md:hidden p-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 border border-white/10 focus:outline-none focus:ring-2 focus:ring-${accentName}-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer -->
    <div id="mobileMenu" class="hidden md:hidden border-t border-white/10 bg-[#0e1424] px-4 py-4 space-y-2.5">
      ${navLinks.map(n => `<a href="${n.href}" class="block py-1.5 text-sm text-slate-300 hover:text-white">${n.label}</a>`).join('\n      ')}
      <a href="pages/about.html" class="block py-1.5 text-sm text-slate-300 hover:text-white">About Organization</a>
      <div class="pt-2">
        <a href="#contact" class="block w-full text-center py-2 text-xs font-semibold rounded-lg bg-gradient-to-r from-${accentName}-600 to-sky-600 text-white">
          ${conversionGoal}
        </a>
      </div>
    </div>
  </header>

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="relative pt-16 pb-20 px-4 text-center overflow-hidden border-b border-white/5">
      <div class="absolute inset-0 bg-radial-glow pointer-events-none opacity-40"></div>
      <div class="max-w-4xl mx-auto relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium border border-${accentName}-500/30 bg-${accentName}-500/10 text-${accentName}-300 mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          ${badgeText}
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white mb-6 leading-tight tracking-tight">
          ${headline}
        </h1>

        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-8 font-light leading-relaxed">
          ${subheadline}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="#contact" class="w-full sm:w-auto px-6 py-3 rounded-lg bg-gradient-to-r from-${accentName}-600 to-sky-600 hover:opacity-95 text-white font-semibold text-sm transition-all shadow-lg shadow-${accentName}-600/30">
            ${conversionGoal}
          </a>
          <a href="#interactive" class="w-full sm:w-auto px-6 py-3 rounded-lg border border-white/10 hover:border-white/20 bg-white/5 text-slate-200 font-medium text-sm transition-all">
            Explore Interactive Demo
          </a>
        </div>
      </div>
    </section>

    <!-- Key Capabilities / Features -->
    <section id="features" class="py-16 bg-[#0e1424] px-4 border-b border-white/5">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">Engineered for Excellence</h2>
          <p class="text-sm text-slate-400">Validated architectural specifications designed for performance and reliability.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          ${featureCards.map(c => `
          <div class="feature-card p-6 rounded-xl border border-white/10 bg-[#141b2d] hover:border-${accentName}-500/40 transition-all">
            <div class="text-3xl mb-3">${c.icon}</div>
            <h3 class="text-base font-semibold text-white mb-2">${c.title}</h3>
            <p class="text-sm text-slate-400 leading-relaxed">${c.desc}</p>
          </div>`).join('')}
        </div>
      </div>
    </section>

    <!-- Interactive Component Section -->
    <section id="interactive" class="py-16 bg-[#0b0f19] px-4 border-b border-white/5">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs uppercase font-semibold text-${accentName}-400 tracking-wider">Live Simulation</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1 mb-2">Interactive Evaluation Workspace</h2>
          <p class="text-xs text-slate-400">Test parameters and inspect real-time calculated system outputs.</p>
        </div>

        <div class="p-6 sm:p-8 rounded-2xl border border-white/10 bg-[#121829] shadow-2xl">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">
            <div>
              <label for="simulationRange" class="block text-xs font-semibold text-slate-300 mb-2">
                Operational Load Scale: <span id="rangeValue" class="text-${accentName}-400 font-mono font-bold">50</span>%
              </label>
              <input type="range" id="simulationRange" min="10" max="100" value="50" class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-${accentName}-500">
              <p class="text-[11px] text-slate-400 mt-2">Adjust range slider to calculate dynamic system throughput and latency bounds.</p>
            </div>
            <div class="p-4 rounded-xl bg-black/40 border border-white/10 space-y-2 font-mono text-xs">
              <div class="flex justify-between text-slate-400">
                <span>Calculated Throughput:</span>
                <span id="outputThroughput" class="text-emerald-400 font-bold">250k ops/sec</span>
              </div>
              <div class="flex justify-between text-slate-400">
                <span>Estimated P99 Latency:</span>
                <span id="outputLatency" class="text-${accentName}-400 font-bold">0.85 ms</span>
              </div>
              <div class="flex justify-between text-slate-400">
                <span>Confidence Index:</span>
                <span class="text-white font-bold">99.98%</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Metrics Row -->
    <section id="metrics" class="py-14 bg-[#0e1424] px-4 text-center border-b border-white/5">
      <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6">
        ${stats.map(s => `
        <div class="p-4">
          <div class="text-3xl font-extrabold text-${accentName}-400 font-mono">${s.val}</div>
          <div class="text-xs uppercase text-slate-400 mt-1 font-semibold">${s.label}</div>
        </div>`).join('')}
      </div>
    </section>

    <!-- Contact & Lead Form -->
    <section id="contact" class="py-16 bg-[#0b0f19] px-4">
      <div class="max-w-xl mx-auto text-center mb-8">
        <h2 class="text-2xl font-bold text-white mb-2">Connect With Engineering</h2>
        <p class="text-xs text-slate-400">Inquiries are logged with structured validation and persistent telemetry.</p>
      </div>

      <div class="max-w-xl mx-auto p-6 sm:p-8 rounded-2xl border border-white/10 bg-[#121829] shadow-xl">
        <form id="contactForm" class="space-y-4">
          <div>
            <label for="senderName" class="block text-xs font-semibold text-slate-300 mb-1">Full Name</label>
            <input type="text" id="senderName" required placeholder="Alex Vance" class="w-full px-3 py-2 text-sm rounded-lg bg-black/40 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-${accentName}-500 transition-colors">
          </div>
          <div>
            <label for="senderEmail" class="block text-xs font-semibold text-slate-300 mb-1">Work Email</label>
            <input type="email" id="senderEmail" required placeholder="alex@enterprise.org" class="w-full px-3 py-2 text-sm rounded-lg bg-black/40 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-${accentName}-500 transition-colors">
          </div>
          <div>
            <label for="senderMsg" class="block text-xs font-semibold text-slate-300 mb-1">Inquiry Details</label>
            <textarea id="senderMsg" rows="3" required placeholder="Describe deployment scope or project specifications..." class="w-full px-3 py-2 text-sm rounded-lg bg-black/40 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-${accentName}-500 transition-colors"></textarea>
          </div>
          <button type="submit" id="submitBtn" class="w-full py-2.5 rounded-lg bg-gradient-to-r from-${accentName}-600 to-sky-600 text-white font-semibold text-sm hover:opacity-95 transition-all shadow-md shadow-${accentName}-600/30 flex items-center justify-center gap-2">
            <span>Transmit Inquiry</span>
          </button>
        </form>

        <div id="formSuccess" class="hidden mt-4 p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs text-center space-y-1">
          <div class="font-bold flex items-center justify-center gap-1.5">
            <span>✓ Inquiry Successfully Transmitted</span>
          </div>
          <p class="text-slate-300">Your message has been processed by the API and queued for partner response.</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-white/10 bg-[#070a12] py-8 text-center text-xs text-slate-500">
    <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        © 2026 ${brandName}. Generated with VibeForge 2.0 Full-Stack Platform.
