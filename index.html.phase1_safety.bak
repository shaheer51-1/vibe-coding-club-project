    ];
    entityName = "listings";
  } else if (archetype === 'editorial') {
    brandName = "The Tech Frontier Review";
    targetAudience = "Engineers, Scientists, Founders & Policy Makers";
    conversionGoal = "Subscribe to Quarterly Journal";
    headline = "Rigorous Investigative Journalism on Emerging Technologies";
    subheadline = "Independent deep-dives into quantum computing breakthroughs, semiconductor geopolitics, and AI safety research.",
    badgeText = "Issue 42 • Autumn 2026 Edition";
    navLinks = [
      { label: "Dispatches", href: "#features" },
      { label: "Latest Paper", href: "#interactive" },
      { label: "Readership", href: "#metrics" },
      { label: "Subscribe", href: "#contact" }
    ];
    featureCards = [
