      { title: "Zero Sponsored Fluff", desc: "100% subscriber-funded. No affiliate links, native ads, or algorithmic clickbait.", icon: "📰" },
      { title: "Interactive Datasets", desc: "Open-source CSV data, reproducible research charts, and interactive technical models.", icon: "📊" }
    ];
    stats = [
