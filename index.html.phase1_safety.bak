<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VibeForge 2.0 — AI Website Builder</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            charcoal: {
              950: '#07090e',
              900: '#0b0d13',
              850: '#0f121a',
              800: '#121622',
              750: '#151b2a',
              700: '#181e2e'
            },
            violet: {
              400: '#a78bfa',
              500: '#8b5cf6',
              600: '#7c3aed',
              700: '#6d28d9'
            },
            electric: {
              400: '#60a5fa',
              500: '#3b82f6',
              600: '#2563eb'
            }
          }
        }
      }
    }
  </script>

  <!-- React 18 & ReactDOM 18 -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  
  <!-- Babel Standalone for in-browser JSX compilation (pinned to avoid unpkg redirect) -->
  <script src="https://unpkg.com/@babel/standalone@8.0.7/babel.min.js"></script>

  <!-- JSZip 3.10.1 for Client-Side ZIP Packaging -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    body {
      margin: 0; padding: 0;
      background-color: #0b0d13;
      color: #f8fafc;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0b0d13; }
    ::-webkit-scrollbar-thumb { background: #1e2638; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #2e3b56; }
    .code-font { font-family: 'JetBrains Mono', Consolas, Monaco, monospace; }
    .glass-panel {
      background: rgba(18,22,34,0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255,255,255,0.08);
    }
    .brand-gradient { background: linear-gradient(135deg,#8b5cf6 0%,#3b82f6 50%,#06b6d4 100%); }
    .brand-gradient-text {
      background: linear-gradient(135deg,#a78bfa 0%,#60a5fa 50%,#38bdf8 100%);
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    }
    .btn-gradient {
      background: linear-gradient(135deg,#8b5cf6 0%,#3b82f6 100%);
      transition: all 0.2s cubic-bezier(0.4,0,0.2,1);
    }
    .btn-gradient:hover:not(:disabled) {
      filter: brightness(1.15);
      box-shadow: 0 0 20px -3px rgba(139,92,246,0.5);
      transform: translateY(-1px);
    }
    .btn-gradient:active:not(:disabled) { transform: translateY(0); filter: brightness(0.95); }

    /* ===== SKELETON SHIMMER ===== */
    @keyframes vf-shimmer {
      0%   { background-position: -800px 0; }
      100% { background-position:  800px 0; }
    }
    .skeleton-base { background:#141b2d; border-radius:8px; position:relative; overflow:hidden; }
    .skeleton-shimmer {
      background: linear-gradient(90deg,#141b2d 0%,#1c2840 30%,#243250 50%,#1c2840 70%,#141b2d 100%);
      background-size: 1600px 100%;
      animation: vf-shimmer 1.55s ease-in-out infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      .skeleton-shimmer { animation: none !important; background: #141b2d !important; }
      .vf-card-hover    { transition: none !important; }
      .btn-gradient     { transition: none !important; }
      .vf-fadein        { animation: none !important; }
    }

    /* ===== LAYOUT SHELL ===== */
    .vf-app-shell { display:flex; flex-direction:column; height:100vh; overflow:hidden; }
    .vf-dashboard-layout { display:flex; flex:1; overflow:hidden; }
    .vf-sidebar {
      width:220px; flex-shrink:0;
      background:#0d1222;
      border-right:1px solid rgba(255,255,255,0.07);
      display:flex; flex-direction:column;
      overflow-y:auto; overflow-x:hidden;
    }
    .vf-sidebar::-webkit-scrollbar { width:3px; }
    .vf-sidebar::-webkit-scrollbar-thumb { background:#1e2638; }
    .vf-main-area { flex:1; overflow-y:auto; overflow-x:hidden; display:flex; flex-direction:column; }
    .vf-right-panel {
      width:280px; flex-shrink:0;
      background:#0d1222;
      border-left:1px solid rgba(255,255,255,0.07);
      overflow-y:auto; overflow-x:hidden;
    }
    .vf-right-panel::-webkit-scrollbar { width:3px; }
    .vf-right-panel::-webkit-scrollbar-thumb { background:#1e2638; }

    /* ===== TOP BAR ===== */
    .vf-topbar {
      height:56px; background:#0b0f1a;
      border-bottom:1px solid rgba(255,255,255,0.07);
      display:flex; align-items:center; padding:0 16px; gap:10px; flex-shrink:0;
    }

    /* ===== NAVIGATION ===== */
    .vf-nav-active {
      background: linear-gradient(135deg,rgba(109,40,217,0.35) 0%,rgba(59,130,246,0.2) 100%);
      border-left:2px solid #7c3aed; color:#c4b5fd;
    }
    .vf-nav-item {
      border-left:2px solid transparent;
      transition: background 0.14s ease, color 0.14s ease;
    }
    .vf-nav-item:hover { background:rgba(255,255,255,0.04); color:#e2e8f0; }

    /* ===== CARDS ===== */
    .vf-card-hover {
      transition: transform 0.22s cubic-bezier(0.16,1,0.3,1),
                  box-shadow 0.22s cubic-bezier(0.16,1,0.3,1),
                  border-color 0.2s ease;
    }
    .vf-card-hover:hover { transform:translateY(-2px) scale(1.005); box-shadow:0 8px 32px rgba(59,130,246,0.12); }

    /* ===== FADE IN ===== */
    @keyframes vf-fadein { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:none} }
    .vf-fadein { animation: vf-fadein 0.32s cubic-bezier(0.16,1,0.3,1) both; }

    /* ===== TEMPLATE CARD HOVER OVERLAY ===== */
    .tmpl-overlay {
      position:absolute; inset:0; border-radius:0;
      background:linear-gradient(to top,rgba(0,0,0,0.85) 0%,rgba(0,0,0,0.05) 60%);
      opacity:0; transition:opacity 0.2s ease;
      display:flex; align-items:flex-end; padding:8px;
    }
    .vf-card-hover:hover .tmpl-overlay { opacity:1; }

    /* ===== GENERATION PROGRESS ===== */
    @keyframes vf-indeterminate {
      0%   { left:-45%; width:40%; }
      60%  { left:100%; width:40%; }
      100% { left:100%; width:0; }
    }
    .vf-progress-bar { position:relative; overflow:hidden; border-radius:9999px; background:#1e2638; }
    .vf-progress-fill {
      position:absolute; top:0; bottom:0;
      background:linear-gradient(90deg,transparent,rgba(139,92,246,0.9),transparent);
      animation: vf-indeterminate 1.7s ease-in-out infinite;
    }

    /* ===== GENERATION DOTS ===== */
    @keyframes vf-dot { 0%,80%,100%{transform:scale(0.5);opacity:0.3} 40%{transform:scale(1);opacity:1} }
    .vf-dot-1 { animation: vf-dot 1.2s 0.0s ease-in-out infinite; }
    .vf-dot-2 { animation: vf-dot 1.2s 0.2s ease-in-out infinite; }
    .vf-dot-3 { animation: vf-dot 1.2s 0.4s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) {
      .vf-dot-1,.vf-dot-2,.vf-dot-3 { animation:none; opacity:1; transform:none; }
      .vf-progress-fill { animation:none; width:60%; }
    }

    /* ===== HERO GRADIENT ===== */
    .vf-hero-bg {
      background:
        radial-gradient(ellipse 80% 55% at 55% 5%,rgba(59,130,246,0.13) 0%,transparent 70%),
        radial-gradient(ellipse 45% 55% at 92% 50%,rgba(139,92,246,0.10) 0%,transparent 70%);
    }

    /* ===== SPINNER ===== */
    @keyframes vf-spin { to { transform: rotate(360deg); } }
    .vf-spinner {
      width:32px; height:32px; border-radius:50%;
      border:3px solid rgba(139,92,246,0.25); border-top-color:#8b5cf6;
      animation: vf-spin 0.8s linear infinite;
    }
    @media (prefers-reduced-motion: reduce) { .vf-spinner { animation:none; } }

    /* ===== RESPONSIVE ===== */
    @media (max-width:900px)  { .vf-sidebar,.vf-right-panel { display:none !important; } }
    @media (max-width:1200px) { .vf-right-panel { width:240px; } }

    /* App root fade-in */
    #root > * { animation: vf-fadein 0.35s ease both; }
  </style>
</head>
<body class="selection:bg-violet-500 selection:text-white">
  <!-- Root React Mount Node -->
  <div id="root"></div>

  <!-- Application Bundle (Babel compiled) -->
  <script type="text/babel">
    const { useState, useEffect, useMemo, useRef } = React;

    // --- Embedded Multi-Section Sample Website HTML ---
    const SAMPLE_WEBSITE_HTML = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ApexSphere — Autonomous Systems</title>
  <script src="https://cdn.tailwindcss.com"><\/script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #0c0e17; color: #f1f5f9; }
    .hero-glow { background: radial-gradient(circle at 50% 20%, rgba(139, 92, 246, 0.25) 0%, rgba(59, 130, 246, 0.12) 40%, transparent 70%); }
    .card-border { border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(18, 22, 35, 0.75); }
    .card-border:hover { border-color: rgba(139, 92, 246, 0.4); transform: translateY(-2px); transition: all 0.2s ease; }
  </style>
</head>
<body class="min-h-screen flex flex-col">
  <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0c0e17]/80 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-violet-600 to-blue-500 flex items-center justify-center font-bold text-white shadow-lg">A</div>
        <span class="font-bold text-lg text-white">Apex<span class="text-violet-400">Sphere</span></span>
      </div>
      <nav class="hidden md:flex items-center gap-8 text-sm text-slate-300 font-medium">
        <a href="#features" class="hover:text-white transition-colors">Capabilities</a>
        <a href="#metrics" class="hover:text-white transition-colors">Telemetry</a>
        <a href="#contact" class="hover:text-white transition-colors">Inquiries</a>
      </nav>
      <a href="#contact" class="px-4 py-2 text-xs font-semibold rounded-lg bg-gradient-to-r from-violet-600 to-blue-600 text-white hover:opacity-95 shadow-md">
        Request Pilot
      </a>
    </div>
  </header>

  <section class="relative pt-16 pb-20 hero-glow text-center px-4">
    <div class="max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium border border-violet-500/30 bg-violet-500/10 text-violet-300 mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Neural Navigation Engine v4.2 Active
      </div>
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white mb-6 leading-tight">
        Autonomous Robotics for <span class="bg-gradient-to-r from-violet-400 via-blue-400 to-cyan-400 bg-clip-text text-transparent">Mission-Critical Operations</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-8 font-light">
        Powering sub-millisecond edge perception, decentralized fleet coordination, and adaptive spatial mapping.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#contact" class="w-full sm:w-auto px-6 py-3 rounded-lg bg-violet-600 hover:bg-violet-500 text-white font-medium text-sm transition-all shadow-lg shadow-violet-600/30">
          Schedule Live Evaluation
        </a>
        <a href="#features" class="w-full sm:w-auto px-6 py-3 rounded-lg border border-white/10 hover:border-white/20 bg-white/5 text-slate-200 font-medium text-sm transition-all">
          Inspect Architecture
        </a>
      </div>
    </div>
  </section>

  <section id="features" class="py-16 border-t border-white/5 bg-[#0e101a] px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">Enterprise Autonomous Infrastructure</h2>
        <p class="text-sm text-slate-400">Zero-latency distributed execution designed for unpredictable environments.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card-border p-6 rounded-xl">
          <div class="text-2xl mb-3">⚡</div>
          <h3 class="text-base font-semibold text-white mb-2">Sub-Millisecond Pathing</h3>
          <p class="text-sm text-slate-400">Proprietary spatial vector engines recalculate trajectory vectors 800 times per second.</p>
        </div>
        <div class="card-border p-6 rounded-xl">
          <div class="text-2xl mb-3">🛰️</div>
          <h3 class="text-base font-semibold text-white mb-2">Decentralized Mesh</h3>
          <p class="text-sm text-slate-400">Multi-agent swarms communicate without central points, maintaining tight formations.</p>
        </div>
        <div class="card-border p-6 rounded-xl">
          <div class="text-2xl mb-3">🛡️</div>
          <h3 class="text-base font-semibold text-white mb-2">Zero-Trust Telemetry</h3>
          <p class="text-sm text-slate-400">Hardware-rooted cryptographic verification on every control instruction packet.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="metrics" class="py-14 border-t border-white/5 bg-[#0c0e17] px-4 text-center">
    <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="p-4">
        <div class="text-3xl font-extrabold text-violet-400 font-mono">99.992%</div>
        <div class="text-xs uppercase text-slate-400 mt-1 font-semibold">Reliability</div>
      </div>
      <div class="p-4">
        <div class="text-3xl font-extrabold text-blue-400 font-mono">18.4M+</div>
        <div class="text-xs uppercase text-slate-400 mt-1 font-semibold">Decisions</div>
      </div>
      <div class="p-4">
        <div class="text-3xl font-extrabold text-cyan-400 font-mono">&lt; 1.2ms</div>
        <div class="text-xs uppercase text-slate-400 mt-1 font-semibold">Latency</div>
      </div>
      <div class="p-4">
        <div class="text-3xl font-extrabold text-fuchsia-400 font-mono">140+</div>
        <div class="text-xs uppercase text-slate-400 mt-1 font-semibold">Deployments</div>
      </div>
    </div>
  </section>

  <section id="contact" class="py-16 border-t border-white/5 bg-[#0e101a] px-4">
    <div class="max-w-xl mx-auto text-center mb-8">
      <h2 class="text-2xl font-bold text-white mb-2">Request Technical Briefing</h2>
      <p class="text-xs text-slate-400">Direct inquiries connected to validated database workflows.</p>
    </div>
    <div class="max-w-xl mx-auto card-border p-6 rounded-2xl">
      <form id="inquiryForm" onsubmit="event.preventDefault(); document.getElementById('success').classList.remove('hidden'); document.getElementById('inquiryBtn').classList.add('hidden');" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Full Name</label>
          <input type="text" required placeholder="Dr. Elena Vance" class="w-full px-3 py-2 text-sm rounded-lg bg-black/40 border border-white/10 text-white focus:outline-none focus:border-violet-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Work Email</label>
          <input type="email" required placeholder="elena@robotics.org" class="w-full px-3 py-2 text-sm rounded-lg bg-black/40 border border-white/10 text-white focus:outline-none focus:border-violet-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Deployment Scope</label>
          <textarea rows="3" required placeholder="Describe testbed specifications..." class="w-full px-3 py-2 text-sm rounded-lg bg-black/40 border border-white/10 text-white focus:outline-none focus:border-violet-500"></textarea>
        </div>
        <button type="submit" id="inquiryBtn" class="w-full py-2.5 rounded-lg bg-gradient-to-r from-violet-600 to-blue-600 text-white font-semibold text-sm hover:opacity-95 transition-all">
          Transmit Inquiry
        </button>
      </form>
      <div id="success" class="hidden mt-4 p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs text-center">
        ✓ Inquiry recorded! Verified client-side contact submission.
      </div>
    </div>
  </section>

  <footer class="border-t border-white/10 bg-[#090b11] py-8 text-center text-xs text-slate-500 mt-auto">
    © 2026 ApexSphere Autonomous Systems. Generated with VibeForge 2.0.
  </footer>
</body>
</html>`;

    // --- Professional Full-Stack Template Synthesizer (v2.0) ---
    function synthesizeWebsite(promptText, category = 'SaaS') {

  const lower = (promptText || '').toLowerCase();

  // 1. Archetype Detection across 10 distinct industries
  let archetype = 'saas';
  let primaryColor = '#0ea5e9';    // sky-500
  let secondaryColor = '#0284c7';  // sky-600
  let accentName = 'sky';
  let bgDark = '#0b0f19';
  let surfaceDark = '#111827';
  let surfaceCard = '#1e293b';

  const catLower = (category || '').toLowerCase();

  if (catLower === 'restaurant' || lower.includes('coffee') || lower.includes('restaurant') || lower.includes('cafe') || lower.includes('bakery') || lower.includes('bistro') || lower.includes('cupping')) {
    archetype = 'restaurant';
    primaryColor = '#f59e0b';
    secondaryColor = '#d97706';
    accentName = 'amber';
    bgDark = '#120e0b';
    surfaceDark = '#1c1612';
    surfaceCard = '#292019';
  } else if (catLower === 'portfolio' || lower.includes('portfolio') || lower.includes('architect portfolio') || lower.includes('developer portfolio') || lower.includes('resume') || lower.includes('cv')) {
    archetype = 'portfolio';
    primaryColor = '#06b6d4';
    secondaryColor = '#0891b2';
    accentName = 'cyan';
    bgDark = '#080d1a';
    surfaceDark = '#0e172a';
    surfaceCard = '#1e293b';
  } else if (catLower === 'agency' || lower.includes('agency') || lower.includes('digital product studio') || lower.includes('creative studio') || lower.includes('brand strategy')) {
    archetype = 'agency';
    primaryColor = '#6366f1';
    secondaryColor = '#4f46e5';
    accentName = 'indigo';
    bgDark = '#0a0c1a';
    surfaceDark = '#12162e';
    surfaceCard = '#1a2040';
  } else if (catLower === 'e-commerce' || catLower === 'ecommerce' || lower.includes('storefront') || lower.includes('capsule collection') || lower.includes('e-commerce') || lower.includes('apparel') || lower.includes('boutique') || (lower.includes('shop') && !lower.includes('bootcamp'))) {
    archetype = 'ecommerce';
    primaryColor = '#ec4899';
    secondaryColor = '#db2777';
    accentName = 'pink';
    bgDark = '#130914';
    surfaceDark = '#1f1022';
    surfaceCard = '#2d1832';
  } else if (catLower === 'education' || lower.includes('academy') || lower.includes('bootcamp') || lower.includes('curriculum') || lower.includes('cohort') || lower.includes('syllabus')) {
    archetype = 'education';
    primaryColor = '#10b981';
    secondaryColor = '#059669';
    accentName = 'emerald';
    bgDark = '#08140f';
    surfaceDark = '#0e221b';
    surfaceCard = '#153328';
  } else if (catLower === 'real estate' || catLower === 'realestate' || lower.includes('real estate') || lower.includes('residences') || lower.includes('realty') || lower.includes('architectural residences') || lower.includes('floorplans')) {
    archetype = 'realestate';
    primaryColor = '#14b8a6';
    secondaryColor = '#0d9488';
    accentName = 'teal';
    bgDark = '#091314';
    surfaceDark = '#0e2022';
    surfaceCard = '#163134';
  } else if (catLower === 'editorial' || lower.includes('journal') || lower.includes('editorial') || lower.includes('research paper') || lower.includes('publication') || lower.includes('journalism')) {
    archetype = 'editorial';
    primaryColor = '#f97316';
    secondaryColor = '#ea580c';
    accentName = 'orange';
    bgDark = '#120f0d';
    surfaceDark = '#1c1714';
    surfaceCard = '#2a221d';
  } else if (catLower === 'dashboard' || lower.includes('cloud telemetry') || lower.includes('telemetry portal') || lower.includes('ebpf') || lower.includes('admin portal') || lower.includes('infrastructure monitoring')) {
    archetype = 'dashboard';
    primaryColor = '#8b5cf6';
    secondaryColor = '#7c3aed';
    accentName = 'violet';
    bgDark = '#090a14';
    surfaceDark = '#111326';
    surfaceCard = '#1a1d38';
  } else if (catLower === 'corporate' || lower.includes('corporate law') || lower.includes('strategic advisory') || lower.includes('boardroom') || lower.includes('cross-border') || lower.includes('legal counsel') || lower.includes('advisory practice')) {
    archetype = 'corporate';
    primaryColor = '#3b82f6';
    secondaryColor = '#1d4ed8';
    accentName = 'blue';
    bgDark = '#080d18';
    surfaceDark = '#0f172a';
    surfaceCard = '#1e293b';
  } else {
    archetype = 'saas';
    primaryColor = '#0ea5e9';
    secondaryColor = '#0284c7';
    accentName = 'sky';
    bgDark = '#0b0f19';
    surfaceDark = '#111827';
    surfaceCard = '#1e293b';
  }

  // 2. Synthesize Brand Identity & Copy
  let brandName = "ApexPulse Systems";
  let targetAudience = "Enterprise Engineering Teams & CTOs";
  let conversionGoal = "Schedule Platform Evaluation";
  let headline = `Autonomous Intelligence Platform for Modern Enterprise`;
  let subheadline = `Sub-millisecond data processing, automated cloud orchestration, and real-time operational telemetry.`;
  let badgeText = `${category} Edition • Production Ready`;
  let navLinks = [
    { label: "Capabilities", href: "#features" },
    { label: "Telemetry", href: "#metrics" },
    { label: "Interactive Tool", href: "#interactive" },
    { label: "Contact", href: "#contact" }
  ];
  let featureCards = [
    { title: "High-Throughput Streaming", desc: "Engineered to ingest and process 500k+ events per second with sub-5ms latency.", icon: "⚡" },
    { title: "Resilient Distributed Nodes", desc: "Zero single points of failure with multi-region quorum synchronization.", icon: "🛰️" },
    { title: "Zero-Trust Architecture", desc: "Hardware-rooted cryptographic token validation on every control packet.", icon: "🛡️" }
  ];
  let stats = [
    { val: "99.995%", label: "Verified Uptime" },
    { val: "< 1.2ms", label: "P99 Response" },
    { val: "24M+", label: "Daily Operations" },
    { val: "Zero", label: "Data Drift Incidents" }
  ];
  let entityName = "metrics";

  if (archetype === 'restaurant') {
    brandName = "Artisan Roast & Co.";
    targetAudience = "Specialty Coffee Lovers, Cafes & Connoisseurs";
    conversionGoal = "Order Fresh Roasts & Reserve Cupping Sessions";
