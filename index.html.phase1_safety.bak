  // 7. Generate Interactive Client JS (main.js)
  const mainJs = `// Client Controller & Mock API Interceptor for ${brandName}
console.log("${brandName} Client Runtime Active.");

document.addEventListener('DOMContentLoaded', () => {
  // Mobile Navigation Drawer Toggle
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
      mobileMenuBtn.setAttribute('aria-expanded', !isExpanded);
      mobileMenu.classList.toggle('hidden');
    });
  }

  // 1. Simulation Range Slider
  const rangeInput = document.getElementById('simulationRange');
  const rangeValue = document.getElementById('rangeValue');
  const throughputEl = document.getElementById('outputThroughput');
  const latencyEl = document.getElementById('outputLatency');

  if (rangeInput && rangeValue && throughputEl && latencyEl) {
    rangeInput.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      rangeValue.innerText = val;
      const throughput = (val * 5).toLocaleString();
      const latency = (1.5 - (val * 0.009)).toFixed(2);
      throughputEl.innerText = throughput + 'k ops/sec';
      latencyEl.innerText = latency + ' ms';
    });
  }

  // 2. Contact Form with Mock API Interceptor
  const contactForm = document.getElementById('contactForm');
  const successBox = document.getElementById('formSuccess');
  const submitBtn = document.getElementById('submitBtn');

  if (contactForm) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('senderName')?.value || '';
      const email = document.getElementById('senderEmail')?.value || '';
      const message = document.getElementById('senderMsg')?.value || '';

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="inline-block animate-spin mr-2">◌</span> Transmitting...';
      }

      try {
        // Attempt fetch to backend endpoint, with automatic client-side mock fallback
        let responseOk = false;
        try {
          const res = await fetch('/api/v1/inquiries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, message })
          });
          if (res.ok) responseOk = true;
        } catch (fetchErr) {
          // In sandboxed preview iframe or static export, simulate network dispatch
          await new Promise(r => setTimeout(r, 650));
          responseOk = true;
        }

        if (responseOk) {
          if (contactForm) contactForm.reset();
          if (submitBtn) submitBtn.classList.add('hidden');
          if (successBox) successBox.classList.remove('hidden');
        }
      } catch (err) {
        console.error('Submission error:', err);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Retry Transmission';
        }
      }
    });
  }
});`;

  // 8. Generate Production Express Backend (server.js)
  const serverJs = `// server.js - Production REST API for ${brandName}
import express from 'express';
import cors from 'cors';
import dotenv from 'dotenv';
import path from 'path';
import { fileURLToPath } from 'url';

dotenv.config();

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = process.env.PORT || 3000;

// Middleware
app.use(cors());
app.use(express.json());
app.use(express.static(__dirname));

// In-Memory Telemetry & Inquiry Store (Production can bind to PostgreSQL/Supabase)
const inquiries = [];
const systemStartTime = Date.now();

// 1. Health & Telemetry Endpoint
app.get('/health', (req, res) => {
  res.json({
    status: 'ok',
    service: '${brandName}',
    archetype: '${archetype}',
    timestamp: new Date().toISOString(),
    uptimeSeconds: Math.floor((Date.now() - systemStartTime) / 1000)
  });
});

// 2. Project Metadata Endpoint
app.get('/api/v1/meta', (req, res) => {
  res.json({
    brandName: '${brandName}',
    category: '${category}',
    targetAudience: '${targetAudience}',
    conversionGoal: '${conversionGoal}'
  });
});

// 3. Contact Inquiries Endpoint (with Request Validation)
app.post('/api/v1/inquiries', (req, res) => {
  const { name, email, message } = req.body;

  // Validation
  if (!name || typeof name !== 'string' || name.trim().length < 2) {
    return res.status(400).json({ error: 'Valid name is required (min 2 characters).' });
  }
  if (!email || typeof email !== 'string' || !email.includes('@')) {
    return res.status(400).json({ error: 'Valid email address is required.' });
  }
  if (!message || typeof message !== 'string' || message.trim().length < 5) {
    return res.status(400).json({ error: 'Message must be at least 5 characters.' });
  }

  const newInquiry = {
    id: 'inq_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7),
    createdAt: new Date().toISOString(),
    name: name.trim(),
    email: email.trim().toLowerCase(),
    message: message.trim(),
    status: 'pending'
  };

  inquiries.push(newInquiry);
  console.log(\`[INQUIRY RECORDED] From: \${newInquiry.email} (\${newInquiry.id})\`);

  res.status(201).json({
    success: true,
    message: 'Inquiry registered successfully.',
    inquiryId: newInquiry.id
  });
});

// 4. Category-Specific Data Endpoint
app.get('/api/v1/${entityName}', (req, res) => {
  res.json({
    entity: '${entityName}',
    items: [
      { id: '1', title: 'Primary Asset Alpha', status: 'verified' },
      { id: '2', title: 'Secondary Asset Beta', status: 'operational' }
    ]
  });
});

// Start Server
if (process.env.NODE_ENV !== 'test') {
  app.listen(PORT, () => {
    console.log(\`⚡ ${brandName} Server running on http://localhost:\${PORT}\`);
  });
}

export default app;`;

  // 9. Generate PostgreSQL / Supabase Schema (schema.sql)
  const schemaSql = `-- PostgreSQL / Supabase Schema DDL for ${brandName}
-- Generated by VibeForge 2.0 Full-Stack Engine

-- Enable UUID extension
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- 1. Inquiries Table
CREATE TABLE IF NOT EXISTS inquiries (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
  name VARCHAR(255) NOT NULL,
  email VARCHAR(255) NOT NULL,
  message TEXT NOT NULL,
  status VARCHAR(50) DEFAULT 'pending' NOT NULL
);

-- Index for inquiry timeline and status
CREATE INDEX IF NOT EXISTS idx_inquiries_created_at ON inquiries(created_at DESC);
CREATE INDEX IF NOT EXISTS idx_inquiries_status ON inquiries(status);

-- 2. Category-Specific Entity Table: ${entityName}
CREATE TABLE IF NOT EXISTS ${entityName} (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
  title VARCHAR(255) NOT NULL,
  description TEXT,
  metadata JSONB DEFAULT '{}'::jsonb,
  status VARCHAR(50) DEFAULT 'active' NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_${entityName}_created_at ON ${entityName}(created_at DESC);

-- 3. Row-Level Security (RLS) Configuration
ALTER TABLE inquiries ENABLE ROW LEVEL SECURITY;
ALTER TABLE ${entityName} ENABLE ROW LEVEL SECURITY;

-- Allow public anonymous users to insert contact inquiries
CREATE POLICY "Allow public insert on inquiries"
  ON inquiries FOR INSERT
  TO anon
  WITH CHECK (true);

-- Allow authenticated users / admins to read inquiries
CREATE POLICY "Allow authenticated read on inquiries"
  ON inquiries FOR SELECT
  TO authenticated
  USING (true);

-- Allow public read on category entity
CREATE POLICY "Allow public read on ${entityName}"
  ON ${entityName} FOR SELECT
  TO anon, authenticated
  USING (true);`;

